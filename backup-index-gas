        setTimeout(() => posInput.style.backgroundColor = "", 1000);
    }
}

function handleScan() {
    const fileInput = document.getElementById('fileInput');
    const uploadStatus = document.getElementById('uploadStatus');
    const scanBtn = document.getElementById('scanBtn');
    
    if (fileInput.files.length === 0) {
        uploadStatus.innerText = '⚠️ กรุณาเลือกไฟล์ก่อน';
        uploadStatus.style.color = "red";
        return;
    }

    const file = fileInput.files[0];
    const reader = new FileReader();

    // 🎯 [ส่วนที่เพิ่มใหม่]: ดึงค่าเลข นผ.2 จากช่องอินพุตหน้าเว็บเพื่อส่งไปหลังบ้าน
    const logInputEl = document.getElementById('logNoInput');
    const logNo = logInputEl ? logInputEl.value.trim() : '';

    scanBtn.setAttribute('aria-busy', 'true');
    scanBtn.innerText = "⏳ กำลังสแกน...";
    uploadStatus.innerText = 'กำลังอัปโหลดและส่งข้อมูลไปยัง AI... (อาจใช้เวลา 10-30 วินาที)';
    uploadStatus.style.color = "orange";

    reader.onloadend = function() {
        const fileData = reader.result;
        const fileName = file.name;

        google.script.run
            .withSuccessHandler(function(res) {
                scanBtn.setAttribute('aria-busy', 'false');
                scanBtn.innerText = "📸 สแกนและกรอกข้อมูลอัตโนมัติ";
                
                if (res.success) {
                    uploadStatus.innerText = "✅ " + res.message;
                    uploadStatus.style.color = "green";
                    document.getElementById('invoice_url').value = res.fileUrl; 
                    
                    const data = res.ocrData; 
                    
                    if(data) {
                        if(data.seller) { 
                            document.getElementById('seller_name_search').value = data.seller; 
                            document.getElementById('seller_name').value = data.seller; 
                            populateSellerInfo(); 
                        }
                        
                        if(data.taxid) document.getElementById('tax_id').value = data.taxid;
                        if(data.inv_no) document.querySelector('input[name="doc_no"]').value = data.inv_no; 

                        if(data.doc_date) {
                            document.getElementById('doc_date').value = data.doc_date;
                            updateDateCalculation(); 
                        }

                        if (data.vat_type) {
                            if (data.vat_type === "In Vat 7%") {
                                const radio = document.querySelector('input[name="vat_type"][value="in_vat"]');
                                if(radio) radio.checked = true;
                            } else if (data.vat_type === "Ex Vat 7%") {
                                const radio = document.querySelector('input[name="vat_type"][value="ex_vat"]');
                                if(radio) radio.checked = true;
                            }
                        }

                        if(data.items && data.items.length > 0) {
                            const itemCount = data.items.length;
                            while (currentRowCount < itemCount && currentRowCount < 19) {
                                addRowBatch(); 
                            }

                            for(let i=0; i < Math.min(itemCount, 19); i++) {
                                const item = data.items[i];
                                const rowId = i + 1;
                                
                                const listEl = document.getElementById(`list${rowId}`) || document.getElementsByName(`list${rowId}`)[0];
                                if(listEl) listEl.value = item.list || item.desc || ''; 
                                
                                const quEl = document.getElementById(`qu${rowId}`);
                                if(quEl) quEl.value = item.qu || item.qty || 0;
                                
                                const unEl = document.getElementById(`un${rowId}`);
                                if(unEl) unEl.value = item.un || item.unit || '';
                                
                                const prEl = document.getElementById(`pr${rowId}`);
                                let rawPrice = item.pr || item.price || 0;
                                if(typeof rawPrice === 'string') rawPrice = rawPrice.replace(/,/g, '');
                                if(prEl) prEl.value = rawPrice;
                            }
                            calculateTotals(); 
                        }
                    }
                } else {
                    uploadStatus.innerText = "❌ " + res.message;
                    uploadStatus.style.color = "red";
                }
            })
            .withFailureHandler(function(error) {
                scanBtn.setAttribute('aria-busy', 'false');
                scanBtn.innerText = "📸 สแกนและกรอกข้อมูลอัตโนมัติ";
                uploadStatus.innerText = `❌ ข้อผิดพลาดของระบบ: ${error.message}`;
                uploadStatus.style.color = "red";
            })
            // 🎯 [จุดที่แก้ไข]: พ่วงส่งตัวแปร logNo ตัวล่าสุดเข้าไปในฟังก์ชันเรียบร้อยครับพี่
            .processInvoice(fileData, fileName, logNo); 
    };

    reader.readAsDataURL(file);
}

