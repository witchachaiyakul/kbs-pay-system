// 🎯 ฟังก์ชันแปลง ค.ศ. สากลของปฏิทิน ออกมาโชว์เป็น วว/ดด/พ.ศ. หน้าจอ
function syncDateBE(pickerElement, displayId) {
  const displayInput = document.getElementById(displayId);
  if (!pickerElement || !displayInput) return;
  
  const val = pickerElement.value; 
  if (!val) {
    displayInput.value = ""; 
    return;
  }
  
  const parts = val.split('-');
  if (parts.length === 3) {
    const y = parseInt(parts[0]) + 543; 
    const m = parts[1];
    const d = parts[2];
    displayInput.value = d + '/' + m + '/' + y; 
  }
}

