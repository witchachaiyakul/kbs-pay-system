        setInputValue('tax_id', data.taxid || '');
        setInputValue('tel_no', data.ad_ph || '');
        setInputValue('address_no', data.ad_no || '');
        setInputValue('address_moo', data.ad_m || '');
        setInputValue('address_road', data.ad_rd || '');
        setInputValue('address_subdistrict', data.ad_tb || '');
        setInputValue('address_district', data.ad_mu || '');
        setInputValue('address_province', data.ad_pr || '');
        setInputValue('zip_code', data.postid || '');
        setInputValue('invoice_type', data.invoice_type || '');
    } else {
        // --- รูปแบบที่ 2: สำหรับ Pop-up Modal ( modal_ หรือ edit_ ) ---
        setInputValue(`${prefix}_seller`, data.seller || selectedName || '');
        setInputValue(`${prefix}_taxid`, data.taxid || '');
        setInputValue(`${prefix}_ad_ph`, data.ad_ph || '');
        setInputValue(`${prefix}_ad_no`, data.ad_no || '');
        setInputValue(`${prefix}_ad_m`, data.ad_m || '');
        setInputValue(`${prefix}_ad_rd`, data.ad_rd || '');
        setInputValue(`${prefix}_ad_tb`, data.ad_tb || '');
        setInputValue(`${prefix}_ad_mu`, data.ad_mu || '');
        setInputValue(`${prefix}_ad_pr`, data.ad_pr || '');
        setInputValue(`${prefix}_postid`, data.postid || '');
        setInputValue(`${prefix}_bidder_name`, data.bidder_name || '');
    }
}

