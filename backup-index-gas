function isWorkingDay(dateObj, holidayList = holidays) {
    const dayOfWeek = dateObj.getDay(); // 0 = อาทิตย์, 6 = เสาร์
    if (dayOfWeek === 0 || dayOfWeek === 6) {
        return false;
    }

    const year = dateObj.getFullYear();
    const month = String(dateObj.getMonth() + 1).padStart(2, '0');
    const day = String(dateObj.getDate()).padStart(2, '0');
    const dateStr = `${year}-${month}-${day}`; // รูปแบบ "2026-08-12"

    // รองรับกรณี holidayList เป็น Array ของ Object หรือ String แบบยาว
    if (Array.isArray(holidayList)) {
        const formattedHolidays = holidayList.map(h => {
            let rawDate = (typeof h === 'object' && h !== null) ? h.date : h;
            if (!rawDate) return '';
            const d = new Date(rawDate);
            if (isNaN(d.getTime())) return String(rawDate).trim();
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const dt = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${dt}`;
        });

        if (formattedHolidays.includes(dateStr)) {
            return false;
        }
    }

    return true;
}

function formatDate(date) {
  if (!date || isNaN(date.getTime())) return '';
  const yyyy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, '0');
  const dd = String(date.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
}
        
function debounce(func, delay) {
  let timeoutId;
  return function(...args) {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
      func.apply(this, args);
      }, delay);
  };    
}
        
function formatMoney(amount) { 
  return parseFloat(amount).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}); 
}

