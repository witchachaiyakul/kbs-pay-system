/**
 * 🛠️ ฟังก์ชันนับจำนวน "วันทำการ" ระหว่างวันล่าสุดที่มีประวัติ จนถึงวันที่ขอซื้อ (prDate)
 */
function countWorkingDaysBetween(startDateStr, endDateStr, holidayList = []) {
  let count = 0;
  let curDate = new Date(startDateStr);
  const endDate = new Date(endDateStr);

  curDate.setDate(curDate.getDate() + 1);

  while (curDate <= endDate) {
    if (isWorkingDay(curDate, holidayList)) {
      count++;
    }
    curDate.setDate(curDate.getDate() + 1);
  }

  return count;
}

