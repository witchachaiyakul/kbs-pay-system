// 🎯 8. ฟังก์ชันอัตโนมัติเมื่อสั่งออกเอกสารผ่านระบบ KBSPAY
// 🎯 ออกเลขอัตโนมัติสำหรับ KBSPAY (ใช้อัลกอริทึมและโครงสร้าง ID เดียวกับระบบแมนนวล)
function autoCreatePoFromKbsPay(kbsPayData, methodInput = 'ซื้อ') {
  // 1. แปลงประเภทเอกสารให้ตรงตามมาตรฐานระบบแมนนวล ('po', 'wo', 'fpo')
  let docType = 'po';
  const methodStr = String(methodInput || '').trim();
  if (methodStr.includes('จ้าง')) {
    docType = 'wo';
  } else if (methodStr.includes('น้ำมัน')) {
    docType = 'fpo';
  }

  // 2. ดึงวันที่ขอซื้อ (PR Date)
  const prDate = kbsPayData.qu_date || kbsPayData.pr_date || new Date().toISOString().split('T')[0];

  // 3. คำนวณรันเลขโดยใช้ฟังก์ชันสร้างเลขหลัก
  const generated = generateLogPoNumber(docType, prDate, allPoLogs, allHolidays);

  // 4. ประกอบที่อยู่อย่างละเอียด (รวมที่อยู่เต็มสำหรับ seller_address)
  let fullAddressStr = (kbsPayData.ad_no || kbsPayData.address_no || '').trim();
  if (kbsPayData.ad_m || kbsPayData.address_moo) fullAddressStr += ' ม.' + (kbsPayData.ad_m || kbsPayData.address_moo);
  if (kbsPayData.ad_rd || kbsPayData.address_road) fullAddressStr += ' ถ.' + (kbsPayData.ad_rd || kbsPayData.address_road);
  if (kbsPayData.ad_tb || kbsPayData.address_subdistrict) fullAddressStr += ' ต.' + (kbsPayData.ad_tb || kbsPayData.address_subdistrict);
  if (kbsPayData.ad_mu || kbsPayData.address_district) fullAddressStr += ' อ.' + (kbsPayData.ad_mu || kbsPayData.address_district);
  if (kbsPayData.ad_pr || kbsPayData.address_province) fullAddressStr += ' จ.' + (kbsPayData.ad_pr || kbsPayData.address_province);
  if (kbsPayData.postid || kbsPayData.zip_code) fullAddressStr += ' ' + (kbsPayData.postid || kbsPayData.zip_code);

  // 5. เตรียม Object ข้อมูลสำหรับบันทึกลงคอลเลกชัน log_po
  const newPoRecord = {
    doc_type: docType,
    pr_date: prDate,
    log_po: generated.log_po,
    base_no: generated.base_no,
    sub_no: generated.sub_no,
    year_be: generated.year_be,
    log_no_ref: kbsPayData.log_no || '',
    details: kbsPayData.objective || kbsPayData.details || '',
    total: parseFloat(kbsPayData.total || 0),
    division: kbsPayData.division || '',
    cr_date: kbsPayData.cr_date || kbsPayData.invoice_date || '',
    seller: kbsPayData.seller || kbsPayData.seller_name || '',
    seller2: kbsPayData.seller2 || '',
    seller3: kbsPayData.seller3 || '',
    taxid: kbsPayData.taxid || kbsPayData.tax_id || '',
    ad_ph: kbsPayData.ad_ph || kbsPayData.tel_no || '',
    ad_no: kbsPayData.ad_no || kbsPayData.address_no || '',
    ad_m: kbsPayData.ad_m || kbsPayData.address_moo || '',
    ad_rd: kbsPayData.ad_rd || kbsPayData.address_road || '',
    ad_tb: kbsPayData.ad_tb || kbsPayData.address_subdistrict || '',
    ad_mu: kbsPayData.ad_mu || kbsPayData.address_district || '',
    ad_pr: kbsPayData.ad_pr || kbsPayData.address_province || '',
    postid: Number(kbsPayData.postid || kbsPayData.zip_code) || 0,
    bidder_name: kbsPayData.sell_name || kbsPayData.bidder_name || '',
    seller_address: fullAddressStr.trim(),
    egp_no: kbsPayData.egp_no || '',
    po_date: kbsPayData.po_date || prDate,
    is_manual: false,
    created_at: prDate
  };

  // 6. กำหนด ID เอกสารตรงตามรูปแบบระบบแมนนวล (${docType}_${base}_${sub}_${year})
  const safeDocId = `${docType}_${generated.base_no}_${generated.sub_no}_${generated.year_be}`;

  // 7. ส่งไปบันทึก/อัปเดตลง Firestore
  google.script.run
    .withSuccessHandler(function() {
      console.log("✅ ออกเลข PO อัตโนมัติจาก KBSPAY สำเร็จ:", generated.log_po);
      if (typeof loadLogPoData === 'function') loadLogPoData();
    })
    .saveLogPoToFirestore(newPoRecord, safeDocId);

  return generated;
}

