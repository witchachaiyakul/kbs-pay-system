    const commArray = (data && Array.isArray(data.committee)) ? data.committee : [];
    
    const comm_name1 = (commArray[0] && commArray[0].name) || (data && data.comm_name1) || '';
    const comm_pos1 = (commArray[0] && commArray[0].pos) || (data && data.comm_pos1) || '';

