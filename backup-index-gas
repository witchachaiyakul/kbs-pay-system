function refreshAllDateDisplays() {
  const dateMappings = [
    { picker: 'date_memo_picker', display: 'date_memo_display' },
    { picker: 'date_ctor_picker', display: 'date_ctor_display' },
    { picker: 'date_tor_rp_picker', display: 'date_tor_rp_display' },
    { picker: 'date_req_picker', display: 'date_req_display' },
    { picker: 'date_result_picker', display: 'date_result_display' },
    { picker: 'date_announce_picker', display: 'date_announce_display' },
    { picker: 'date_po_picker', display: 'date_po_display' },
    { picker: 'date_delivery_picker', display: 'date_delivery_display' },
    { picker: 'date_receive_picker', display: 'date_receive_display' }
  ];
  
  dateMappings.forEach(item => {
    const p = document.getElementById(item.picker);
    if (p && p.value) {
      syncDateBE(p, item.display);
    } else {
      const d = document.getElementById(item.display);
      if (d) d.value = "";
    }
  });
}

function openBudgetDetail(fundType) {
  const modalElement = document.getElementById('budgetDetailModal');
  const modal = new bootstrap.Modal(modalElement);
  
  document.getElementById('modalFundTypeTitle').innerText = fundType;
  const loading = document.getElementById('modalLoading');
  const tableWrapper = document.getElementById('modalTableWrapper');
  const emptyMsg = document.getElementById('modalEmptyMsg');
  const tbody = document.getElementById('modalBudgetDetailBody');

  loading.classList.remove('d-none');
  tableWrapper.classList.add('d-none');
  emptyMsg.classList.add('d-none');
  tbody.innerHTML = '';

  modal.show();

  // 🎯 คัดกรองข้อมูลจาก Cache หน้าบ้าน
  let plansData = [];
  if (window.budgetPlansCache && Array.isArray(window.budgetPlansCache)) {
    if (fundType === 'รายได้สถานศึกษารวม') {
      // ดึงทุกรายการที่ fund_type มีคำว่า "รายได้"
      plansData = window.budgetPlansCache.filter(item => 
        item.fund_type && String(item.fund_type).includes('รายได้')
      );
    } else {
      // ดึงเฉพาะหมวดที่ตรงตามชื่อ
      plansData = window.budgetPlansCache.filter(item => item.fund_type === fundType);
    }
  }

  loading.classList.add('d-none');

  if (plansData.length === 0) {
    emptyMsg.classList.remove('d-none');
    return;
  }

