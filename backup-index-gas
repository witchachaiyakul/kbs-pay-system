function searchSeller() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        const query = document.getElementById('seller_name_search').value.trim();
        const status = document.getElementById('seller_search_status');
        const resultInput = document.getElementById('seller_name');
        
        if (query.length < 2) {
            if (status) status.innerText = 'พิมพ์ชื่อร้านค้าอย่างน้อย 2 ตัวอักษร';
            if (resultInput) resultInput.value = '';
            resetSellerFields(true);
            return;
        }
        
        if (status) status.innerText = '⏳ กำลังค้นหาข้อมูล...';
        if (resultInput) resultInput.value = query; // ผูกชื่อไปช่องขวาทันทีที่พิมพ์
        
        const datalist = document.getElementById('seller_list');
        const filteredNames = allSellersData.filter(name => name.toString().toLowerCase().includes(query.toLowerCase()));

        if (datalist) {
            datalist.innerHTML = '';
            filteredNames.forEach(name => {
                const option = document.createElement('option');
                option.value = name.toString().trim();
                datalist.appendChild(option);
            });
        }

        if (status) status.innerText = `✅ พบข้อมูลร้านค้า ${filteredNames.length} รายการ`;

        // ตรวจสอบว่าชื่อที่พิมพ์ตรงกับชื่อในฐานข้อมูลเป๊ะๆ หรือไม่ (หรือเกิดจากการคลิกเลือก)
        if (allSellersData.includes(query)) {
            populateSellerInfo();
        }
    }, 500); 
}
        
// 🎯 ฟังก์ชันดึงและหยอดข้อมูลผู้ขาย (รองรับทั้งฟอร์มเดิม และ Pop-up Modal)
function populateSellerInfo(prefix = '') {
    // 1. กำหนด ID ของช่องค้นหาและข้อความสถานะตาม prefix
    const searchId = prefix ? `${prefix}_seller_search` : 'seller_name_search';
    const statusId = prefix ? `${prefix}_seller_search_status` : 'seller_search_status';

    const searchEl = document.getElementById(searchId);
    if (!searchEl) return;

    const selectedName = searchEl.value.trim();
    if (!selectedName) return;

    const statusEl = document.getElementById(statusId);
    if (statusEl) statusEl.innerText = '⏳ ดึงข้อมูลที่อยู่...';

    // 2. ถ้ามีข้อมูลอยู่ในหน่วยความจำหน้าบ้าน (allSuppliers) ให้ใช้ก่อนทันทีเพื่อความเร็ว
    if (typeof allSuppliers !== 'undefined' && allSuppliers.length > 0) {
        const match = allSuppliers.find(s => s.seller === selectedName || s.taxid === selectedName);
        if (match) {
            applySupplierDataToDOM(match, prefix, selectedName);
            if (statusEl) statusEl.innerText = '✅ ดึงข้อมูลที่อยู่ร้านค้าสำเร็จ';
            return;
        }
    }

    // 3. หากหาในหน่วยความจำไม่พบ ให้ดึงผ่านหลังบ้าน (Google Script)
    google.script.run
        .withSuccessHandler(function(res) {
            if (res && res.success) {
                applySupplierDataToDOM(res.data, prefix, selectedName);
                if (statusEl) statusEl.innerText = '✅ ดึงข้อมูลที่อยู่ร้านค้าสำเร็จ';
            } else {
                const targetSellerId = prefix ? `${prefix}_seller` : 'seller_name';
                setInputValue(targetSellerId, selectedName);
                if (statusEl) statusEl.innerText = `⚠️ ไม่พบข้อมูลที่อยู่เต็ม: ${res ? res.message : ''}`;
                if (typeof resetSellerFields === 'function' && !prefix) {
                    resetSellerFields(true);
                }
            }
        })
        .withFailureHandler(function(error) {
            if (statusEl) statusEl.innerText = `❌ Error: ${error.message}`;
            if (typeof resetSellerFields === 'function' && !prefix) {
                resetSellerFields(true);
            }
        })
        .getSupplierInfo(selectedName);
}

// 🛠️ ฟังก์ชันกลางสำหรับหยอดข้อมูลลงอินพุต (ป้องกัน Element หาไม่เจอ และรองรับ ID ทุกรูปแบบ)
