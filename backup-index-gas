// 🎯 2. [จุดสำคัญ] ลอจิกแตกรายการพัสดุตามจำนวน (qu)
function processAndExpandParcels(logPayList) {
  allExpandedParcels = [];
  currentLogPayCommittees = [];

  const list = Array.isArray(logPayList) ? logPayList : [logPayList];

  list.forEach(doc => {
    const logNo = doc.log_no || '';
    const division = doc.division || 'ไม่ระบุฝ่าย';
    const crDate = doc.cr_date || doc.invoice_date || '-';
    const rawItems = doc.items || [];
    const committees = doc.committee || [];

    // เก็บรายชื่อกรรมการไว้ตัวเลือกเบิกจ่าย
    committees.forEach(c => {
      if (c.name && !currentLogPayCommittees.includes(c.name)) {
        currentLogPayCommittees.push(c.name);
      }
    });

    // 🔄 ลูปตามรายการสินค้า
    rawItems.forEach((item, itemIdx) => {
      const qty = Math.max(1, Math.round(Number(item.qu) || 1));
      const listName = item.list || item.equipment || `รายการที่ ${itemIdx + 1}`;
      const priceUnit = Number(item.pr) || 0;
      const unit = item.un || 'หน่วย';

      // 🎯 แตกแถวตามจำนวน qu (เช่น qu = 4 จะวนซ้ำ 4 รอบ)
      for (let i = 1; i <= qty; i++) {
        const uniqueId = `${logNo}_${itemIdx + 1}_${i}`;
        
        allExpandedParcels.push({
          uid: uniqueId,
          log_no: logNo,
          division: division,
          cr_date: crDate,
          item_name: listName,
          piece_index: `${i}/${qty}`, // เช่น 1/4, 2/4
          unit_price: priceUnit,
          unit: unit,
          parcel_no: doc[`parcel_no_${uniqueId}`] || '', // ถ้าเคยมีเลขพัสดุแล้ว
          status: doc[`status_${uniqueId}`] || 'pending', // pending, registered, issued
          issued_to: doc[`issued_to_${uniqueId}`] || ''
        });
      }
    });
  });

  renderParcelTable(allExpandedParcels);
  populateCommitteeDropdown();
}

// 🎯 3. แสดงผลตารางพัสดุ
function renderParcelTable(dataList) {
  const tbody = document.getElementById('parcelTableBody');
  tbody.innerHTML = '';

  if (dataList.length === 0) {
    tbody.innerHTML = `<tr><td colspan="10" class="text-center py-4 text-muted">ไม่พบรายการพัสดุ</td></tr>`;
    return;
  }

  dataList.forEach((item, idx) => {
    let statusBadge = '<span class="badge bg-secondary">รอออกเลข</span>';
    if (item.status === 'registered') {
      statusBadge = '<span class="badge bg-info text-dark">ออกเลขแล้ว</span>';
    } else if (item.status === 'issued') {
      statusBadge = `<span class="badge bg-success">จ่ายแล้ว (${item.issued_to})</span>`;
    }

    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="text-center">
        <input type="checkbox" class="parcel-checkbox" value="${item.uid}" onchange="updateSelectedCount()">
      </td>
      <td class="fw-bold text-navy">${item.log_no}</td>
      <td>${item.division}</td>
      <td class="text-center">${item.cr_date}</td>
      <td>${item.item_name}</td>
      <td class="text-center fw-bold text-primary">${item.piece_index}</td>
      <td class="text-end">${formatMoney(item.unit_price)}</td>
      <td class="text-center">${item.unit}</td>
      <td class="text-center fw-bold text-danger">${item.parcel_no || '-'}</td>
      <td class="text-center">${statusBadge}</td>
    `;
    tbody.appendChild(tr);
  });

  updateSelectedCount();
}

// 🎯 4. การเลือกรายการ และ นับจำนวน
function toggleSelectAllParcels(master) {
  const checkboxes = document.querySelectorAll('.parcel-checkbox');
  checkboxes.forEach(cb => cb.checked = master.checked);
  updateSelectedCount();
}

function updateSelectedCount() {
  const selected = document.querySelectorAll('.parcel-checkbox:checked').length;
  document.getElementById('selectedCountReg').innerText = selected;
  document.getElementById('selectedCountIssue').innerText = selected;
}

// 🎯 5. ลอจิกการออกเลขพัสดุ (Format: ประเภทเงิน/ลำดับ/ปีงบประมาณ)
function confirmGenerateParcelIDs() {
  const selectedBoxes = document.querySelectorAll('.parcel-checkbox:checked');
  if (selectedBoxes.length === 0) {
    alert('กรุณาติ๊กเลือกรายการพัสดุที่ต้องการออกเลขอย่างน้อย 1 รายการ');
    return;
  }

  const fundType = document.getElementById('parcelFundType').value;
  const yearBE = document.getElementById('parcelYearBE').value;

  if (!confirm(`ยืนยันการออกเลขพัสดุสำหรับรายการที่เลือกจำนวน ${selectedBoxes.length} รายการ?`)) return;

  const targetUids = Array.from(selectedBoxes).map(cb => cb.value);

  google.script.run
    .withSuccessHandler(function(res) {
      if (res.success) {
        alert('✅ ออกเลขพัสดุสำเร็จ!');
        loadParcelDataFromLogPay();
      } else {
        alert('❌ เกิดข้อผิดพลาด: ' + res.message);
      }
    })
    .generateParcelNumbersBackend(targetUids, fundType, yearBE);
}

// 🎯 6. ลอจิกการเปิด Modal เบิกจ่ายพัสดุ
function openIssueModal() {
  const selectedBoxes = document.querySelectorAll('.parcel-checkbox:checked');
  if (selectedBoxes.length === 0) {
    alert('กรุณาติ๊กเลือกรายการพัสดุที่ต้องการเบิกจ่าย');
    return;
  }
  const modal = new bootstrap.Modal(document.getElementById('issueParcelModal'));
  modal.show();
}

function populateCommitteeDropdown() {
  const select = document.getElementById('issueRecipientSelect');
  select.innerHTML = '<option value="">-- เลือกจากรายชื่อกรรมการ/ผู้ขอซื้อ --</option>';
  currentLogPayCommittees.forEach(name => {
    const opt = document.createElement('option');
    opt.value = name;
    opt.innerText = name;
    select.appendChild(opt);
  });
}

function syncRecipientInput(selectElem) {
  if (selectElem.value) {
    document.getElementById('issueRecipientCustom').value = selectElem.value;
  }
}

function executeIssueParcels() {
  const recipient = document.getElementById('issueRecipientCustom').value.trim();
  const issueDate = document.getElementById('issueDateInput').value;

  if (!recipient) {
    alert('กรุณาระบุชื่อผู้รับเบิกพัสดุ');
    return;
  }

  const selectedBoxes = document.querySelectorAll('.parcel-checkbox:checked');
  const targetUids = Array.from(selectedBoxes).map(cb => cb.value);

  google.script.run
    .withSuccessHandler(function(res) {
      if (res.success) {
        alert('✅ บันทึกการเบิกจ่ายพัสดุเรียบร้อย!');
        bootstrap.Modal.getInstance(document.getElementById('issueParcelModal')).hide();
        loadParcelDataFromLogPay();
      } else {
        alert('❌ เกิดข้อผิดพลาด: ' + res.message);
      }
    })
    .issueParcelsBackend(targetUids, recipient, issueDate);
}
</script>
