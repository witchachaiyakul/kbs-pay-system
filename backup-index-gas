<!DOCTYPE html>
<html lang="th">
<head>
    <base target="_top">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบบริหารจัดการกลุ่มงานงบประมาณ - โรงเรียนกาญจนาภิเษกวิทยาลัย กระบี่</title>

    <!-- 1. Bootstrap 5, Bootstrap Icons, Google Fonts Sarabun และ Google Charts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://www.gstatic.com/charts/loader.js"></script>

    <style>
        /* ==========================================================================
           1. Global Variables & Theme Palette (ขาว - น้ำเงิน - ทอง - ดำ) 🎨
           ========================================================================== */
        :root {
            --navy-dark: #0f172a;       /* น้ำเงินเข้ม/ดำ */
            --navy-primary: #1e3a8a;    /* น้ำเงินหลัก */
            --gold-accent: #d4af37;     /* สีทองพรีเมียม */
            --gold-hover: #b89228;      /* สีทองเข้ม */
            --bg-light: #f8fafc;        /* พื้นหลังขาวอมเทา */
            --text-dark: #0f172a;       /* ตัวอักษรดำเข้ม */
            --border-color: #cbd5e1;    /* สีเส้นขอบ */
            --border-radius: 0.75rem;
        }

        body {
            background-color: var(--bg-light) !important;
            color: var(--text-dark) !important;
            font-family: 'Sarabun', sans-serif;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* ==========================================================================
           2. Navbar & Header Banner 👑
           ========================================================================== */
        .header-banner {
            background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy-primary) 100%);
            border-bottom: 4px solid var(--gold-accent);
            padding: 2.5rem 1.5rem;
            border-radius: var(--border-radius);
            text-align: center;
            margin-bottom: 2rem;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
        }

        .header-banner .brand-title {
            color: var(--gold-accent) !important;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.4rem;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .header-banner .brand-subtitle {
            color: #ffffff !important;
            font-size: 1.15rem;
            margin: 0;
            opacity: 0.95;
        }

        /* ==========================================================================
           3. Dashboard Menu Cards 🃏
           ========================================================================== */
        .menu-card {
            background-color: #ffffff !important;
            border: 2px solid var(--border-color) !important;
            border-radius: var(--border-radius) !important;
            transition: all 0.25s ease-in-out;
            cursor: pointer;
            padding: 2.25rem 1.5rem;
            text-align: center;
        }

        .menu-card:hover {
            transform: translateY(-5px);
            border-color: var(--gold-accent) !important;
            box-shadow: 0 12px 25px rgba(30, 58, 138, 0.12) !important;
        }

        .icon-box {
            font-size: 3rem;
            color: var(--navy-primary);
            margin-bottom: 1rem;
            transition: transform 0.25s ease;
        }

        .menu-card:hover .icon-box {
            color: var(--gold-accent);
            transform: scale(1.08);
        }

        /* ==========================================================================
           4. Form Structure 📦
           ========================================================================== */
        .card-section {
            background-color: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
            margin-bottom: 1.75rem;
            overflow: hidden;
            width: 100%;
        }

        .card-section-header {
            background-color: var(--navy-primary);
            color: #ffffff;
            padding: 0.85rem 1.25rem;
            font-weight: 600;
            font-size: 1.05rem;
            border-bottom: 3px solid var(--gold-accent);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-section-header i {
            color: var(--gold-accent);
            font-size: 1.2rem;
        }

        /* ==========================================================================
           5. Form Controls & Inputs 📝
           ========================================================================== */
        .form-label {
            color: var(--navy-dark);
            margin-bottom: 0.35rem;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .form-control, .form-select {
            border-color: #cbd5e1;
            border-radius: 0.5rem;
            padding: 0.68rem 0.9rem;
            font-size: 0.95rem;
            color: var(--navy-dark);
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--navy-primary);
            box-shadow: 0 0 0 0.25rem rgba(30, 58, 138, 0.15);
        }

        .form-control[readonly], .form-control[disabled] {
            background-color: #f1f5f9 !important;
            color: #334155 !important;
        }

        #logNoInput {
            border: 2px solid var(--navy-primary) !important;
            font-size: 1.1rem;
        }

        .upload-box {
            border: 2px dashed var(--gold-accent);
            background-color: #fefce8;
            border-radius: var(--border-radius);
            padding: 1.5rem;
            text-align: center;
        }

        /* ==========================================================================
           6. Item Tables & Summary Boxes 📊
           ========================================================================== */
        .item-table {
            width: 100%;
            border-collapse: collapse;
        }

        .item-table th {
            background-color: var(--navy-primary) !important;
            color: #ffffff !important;
            border-bottom: 3px solid var(--gold-accent);
            padding: 10px 8px;
            font-weight: 600;
            text-align: center;
        }

        .summary-card {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: var(--border-radius);
            padding: 1.5rem;
        }

        .date-summary-table {
            width: 100%;
            border: 1px solid #dee2e6;
            border-radius: var(--border-radius);
            overflow: hidden;
        }

        .date-summary-table th {
            background-color: #f1f5f9;
            color: var(--navy-dark);
            width: 60%;
            padding: 10px 12px;
            font-weight: 600;
        }

        .date-summary-table td {
            padding: 8px 12px;
            vertical-align: middle;
        }

        /* ==========================================================================
           7. Buttons 🔘
           ========================================================================== */
        .btn-navy {
            background-color: var(--navy-primary);
            color: #ffffff;
            border: 1px solid var(--navy-primary);
            font-weight: 600;
        }

        .btn-navy:hover {
            background-color: var(--gold-accent);
            color: var(--navy-dark);
            border-color: var(--gold-accent);
        }

        .btn-outline-navy {
            color: var(--navy-primary);
            border: 1.5px solid var(--navy-primary);
            font-weight: 600;
        }

        .btn-outline-navy:hover {
            background-color: var(--navy-primary);
            color: #ffffff;
        }

        .btn-back {
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: var(--navy-primary);
        }

        .btn-back:hover {
            color: var(--gold-hover);
        }

        /* ==========================================================================
           8. Budget Module KPIs 📈
           ========================================================================== */
        .kbsbudget-wrap { max-width: 100%; margin: 0 auto; }
        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .grid-kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px; }
        
        .card-kpi {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-left: 5px solid var(--navy-primary);
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
        }
        .kpi-label { font-size: 14px; color: #64748b; }
        .kpi-value { font-size: 28px; font-weight: 700; color: var(--navy-dark); }
        .kpi-highlight { color: #d97706; }

        /* ==========================================================================
           🎯 ปลดล็อกความกว้างเต็มหน้าจอ 100% ชิดขอบสำหรับ MODULE 4 (KBS LOG NO)
           ========================================================================== */
        #kbslogno, 
        #kbslogno .kbs-main,
        #kbslogno .card-section {
            max-width: 100% !important;
            width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        /* ==========================================================================
           9. Print Rules 🖨️
           ========================================================================== */
        @media print {
            button, .no-print, #scanBtn, #saveBtn, #printBtn, .btn-back, nav {
                display: none !important;
            }
            body { background: white !important; color: black !important; }
            .card-section { border: none !important; box-shadow: none !important; }
            .form-control, .form-select { border: none !important; background: transparent !important; }
        }
    </style>
</head>
<body>

<!-- Navbar ด้านบน -->
<nav class="navbar navbar-expand-lg navbar-dark shadow-sm mb-4" style="background-color: var(--navy-dark); border-bottom: 2px solid var(--gold-accent);">
  <div class="container-fluid d-flex justify-content-between align-items-center">
    <span class="navbar-brand mb-0 h1 text-white">
      <i class="bi bi-speedometer2 me-2" style="color: var(--gold-accent);"></i>ระบบบริหารจัดการกลุ่มงานงบประมาณ
    </span>
    
    <div class="d-none align-items-center text-white" id="userHeaderProfile">
      <img id="headerUserImg" src="https://cdn-icons-png.flaticon.com/512/149/149071.png" alt="Profile" class="rounded-circle me-2" style="width: 38px; height: 38px; object-fit: cover; border: 2px solid var(--gold-accent);">
      <div>
        <div class="fw-bold small" id="headerUserName">Loading...</div>
        <small class="text-white-50" style="font-size: 11px;" id="headerUserRole">ผู้ทำรายการ</small>
      </div>
    </div>
  </div>
</nav>

<div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer" style="z-index: 1080;"></div>

<!-- ==========================================================================
     MAIN DASHBOARD
     ========================================================================== -->
<div id="mainDashboard" class="container">
  <div class="header-banner">
    <h1 class="brand-title">KBS</h1>
    <p class="brand-subtitle">ระบบบริหารจัดการกลุ่มบริหารงานงบประมาณ โรงเรียนกาญจนาภิเษกวิทยาลัย กระบี่</p>
  </div>

  <div class="row g-3 text-center justify-content-center">
    <div class="col-md-6 col-lg-3">
      <div class="card menu-card h-100" onclick="showForm('kbsPay')">
        <div class="icon-box"><i class="bi bi-file-earmark-text-fill"></i></div>
        <h3>จัดทำเอกสารจัดซื้อจัดจ้าง</h3>
        <p>ระบบพิมพ์เบิกและจัดการสัญญา</p>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="card menu-card h-100" onclick="showForm('kbsbudget')">
        <div class="icon-box"><i class="bi bi-pie-chart-fill"></i></div>
        <h3>งานแผนโครงการ</h3>
        <p>ตรวจสอบและแก้ไขงบประมาณ</p>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="card menu-card h-100" onclick="showForm('kbsbudgetuse')">
        <div class="icon-box"><i class="bi bi-file-earmark-text-fill"></i></div>
        <h3>ตัดแผน</h3>
        <p>ตรวจสอบวงเงินและตัดแผนงบประมาณ</p>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="card menu-card h-100" onclick="showForm('kbslogno')">
        <div class="icon-box"><i class="bi bi-file-earmark-text-fill"></i></div>
        <h3>เลขที่ใบสั่งซื้อสั่งจ้าง</h3>
        <p>ออกเลขและตรวจสอบข้อมูล</p>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="card menu-card h-100" onclick="showForm('kbsparcelmanage')">
        <div class="icon-box"><i class="bi bi-file-earmark-text-fill"></i></div>
        <h3>การบริหารพัสดุ</h3>
        <p>ออกเลข เบิกจ่าย</p>
      </div>
    </div>

    </div>
  </div>
</div>

<!-- ==========================================================================
     MODULE 1: KBS PAY (จัดทำเอกสารจัดซื้อจัดจ้าง)
     ========================================================================== -->
<div id="kbsPay" class="form-container d-none container py-3">
  <!-- ปุ่มย้อนกลับหน้าหลัก -->
  <div class="btn-back mb-3" onclick="resetFormToMain()">
    <i class="bi bi-arrow-left"></i> กลับหน้าหลัก
  </div>

  <main class="kbs-main">
    <!-- แถบแสดงโปรไฟล์ LINE ในฟอร์ม -->
    <div id="userInfoBar" class="user-info-bar d-none mb-4">
      <div class="d-flex align-items-center gap-3">
        <img id="userPicture" src="" alt="LINE Profile" class="profile-img">
        <div>
          <div>
            <strong id="userName">กำลังดึงข้อมูล...</strong>
            <span id="userRole" class="badge ms-1" style="background-color: var(--navy-primary, #1e3a8a); color: #fff;">-</span>
          </div>
          <small class="text-muted">ล็อกอินด้วย LINE</small>
        </div>
      </div>
      <a href="?" target="_top" class="btn btn-outline-danger btn-sm">🚪 ออกจากระบบ</a>
    </div>
    
    <div class="text-center mb-4">
      <h2 class="h3 fw-bold text-navy mb-1">📑พิมพ์เอกสารเบิกจ่ายงานจัดซื้อจัดจ้าง</h2>
      <div class="mx-auto" style="height: 3px; width: 120px; background-color: var(--gold-accent, #d4af37);"></div>
    </div>
    
    <form id="kbsForm">
      <!-- Hidden Inputs สำหรับรับค่าและจัดการระบบ -->
      <input type="hidden" name="invoice_url" id="invoice_url">
      <input type="hidden" name="date_req_hidden" id="date_req_hidden">
      <input type="hidden" name="date_result_hidden" id="date_result_hidden">
      <input type="hidden" name="date_announce_hidden" id="date_announce_hidden">
      <input type="hidden" name="date_po_hidden" id="date_po_hidden">
      <input type="hidden" name="date_delivery_hidden" id="date_delivery_hidden">
      <input type="hidden" name="date_receive_hidden" id="date_receive_hidden">
      <input type="hidden" name="row_number" id="row_number" value="0">

<!-- Section 1: ข้อมูลจากงานแผน -->
<div class="card-section">
  <div class="card-section-header">
    <i class="bi bi-search"></i> ข้อมูลจากงานแผน กรุณาตัดแผนกับครูด้าโอ้ดก่อน
  </div>
  <div class="card-body p-4">
    <div class="mb-3">
      <label class="form-label fw-bold">กรอกเลข นผ.2 <small class="text-muted fw-normal">(ถ้ายังไม่มี กรุณาส่งเอกสารให้ครูด้าโอ้ดตัดแผนก่อนเพื่อออกเลข)</small></label>
      <div class="input-group">
        <input type="text" id="logNoInput" name="LOG_NO" class="form-control fw-bold border-primary" required placeholder="พิมพ์เลข นผ.2 ที่นี่..." autocomplete="off">
        <button type="button" id="btnSearchLog" onclick="searchBudgetInfo()" class="btn btn-navy px-4">
          🔍 ค้นหาข้อมูล
        </button>
      </div>
      <small id="searchStatus" class="text-muted d-block mt-1">* กรอกเลขแล้วคลิกปุ่ม "ค้นหาข้อมูล"</small>
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">โครงการ</label>
        <input type="text" name="project" id="project" class="form-control bg-light" readonly>
      </div>
      <div class="col-md-6">
        <label class="form-label">กิจกรรม</label>
        <input type="text" name="activities" id="activities" class="form-control bg-light" readonly>
      </div>
      <div class="col-md-6">
        <label class="form-label">งบประมาณขอใช้ครั้งนี้</label>
        <input type="text" name="quantity" id="quantity" class="form-control bg-light" readonly>
      </div>
      <div class="col-md-6">
        <label class="form-label">วิธีการ</label>
        <input type="text" name="method" id="method" class="form-control bg-light" readonly>
      </div>
      <div class="col-12">
        <label class="form-label">รายละเอียด</label>
        <textarea name="details" id="details" class="form-control" rows="2"></textarea>
      </div>
      <div class="col-md-8">
        <label class="form-label">เหตุผลที่จะซื้อ/จ้าง (เพื่อ...)</label>
        <input type="text" name="to" class="form-control" placeholder="ระบุเหตุผลความจำเป็น..." required>
      </div>
      <div class="col-md-4">
        <label class="form-label">กำหนดการส่งมอบภายใน (วัน)</label>
        <input type="number" name="delivery_days" id="deliveryDays" class="form-control" value="7" min="1" oninput="updateDateCalculation()">
      </div>
      <div class="col-12">
        <label class="form-label">ฝ่าย/งาน</label>
        <select name="division" id="division" class="form-select" required>
          <option value="" disabled selected>--- เลือกฝ่าย/งาน ---</option>
          <option value="บริหารทั่วไป">บริหารทั่วไป</option>
          <option value="บุคคล">บุคคล</option>
          <option value="วิชาการ">วิชาการ</option>
          <option value="งบประมาณ">งบประมาณ</option>
          <option value="กิจการนักเรียน">กิจการนักเรียน</option>
          <option value="หอพัก">หอพัก</option>
          <option value="โครงการห้องเรียนกีฬา">โครงการห้องเรียนกีฬา</option>
        </select>
      </div>

      <!-- ➕ เพิ่มส่วน ผู้ขอซื้อ และ ตำแหน่งผู้ขอซื้อ หลังฝ่าย/งาน -->
      <div class="col-md-6">
        <label class="form-label fw-bold">ผู้ขอซื้อ/ขอจ้าง <small class="text-muted"></small></label>
        <input type="text" id="buyer" name="buyer" class="form-control" list="committee_list" placeholder="พิมพ์หรือเลือกชื่อผู้ขอซื้อ..." onchange="autoFillBuyerPos()" required autocomplete="off">
        <datalist id="committee_list"></datalist>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-bold">ตำแหน่งผู้ขอซื้อ <small class="text-muted"></small></label>
        <input type="text" id="pos_buyer" name="pos_buyer" class="form-control bg-light" placeholder="ตำแหน่งจะดึงมาให้อัตโนมัติ" readonly>
      </div>
    </div>
  </div>
</div>

<!-- 🎯 ช่องแสดงเลข PO/WO ต่อจากตำแหน่งผู้ขอซื้อ -->
<div class="col-md-6 mb-3">
  <label for="po_no_display" class="form-label fw-bold">เลขที่ใบสั่งซื้อ/สั่งจ้าง:</label>
  <input type="text" id="po_no_display" class="form-control bg-light fw-bold text-primary" readonly placeholder="(ระบบจะออกเลขอัตโนมัติเมื่อกดบันทึก)">
  
  <!-- Hidden Fields สำหรับดึงค่าเดิมกลับไปบันทึกเมื่อแก้ไข -->
  <input type="hidden" id="po_no_hidden" name="po_no_hidden">
  <input type="hidden" id="po_base_no_hidden" name="po_base_no_hidden">
  <input type="hidden" id="po_sub_no_hidden" name="po_sub_no_hidden">
  <input type="hidden" id="po_year_be_hidden" name="po_year_be_hidden">
</div>

      <!-- Upload Box -->
      <div class="upload-box mb-4">
        <h5 class="fw-bold text-navy mb-3"><i class="bi bi-cloud-upload me-2"></i>อัปโหลด ใบส่งของ / ใบกำกับภาษี</h5>
        <div class="row g-2 justify-content-center align-items-center">
          <div class="col-md-6">
            <input type="file" id="fileInput" class="form-control" accept="image/*, application/pdf">
          </div>
          <div class="col-md-auto">
            <button type="button" id="scanBtn" class="btn btn-navy px-4" onclick="handleScan()">📸 สแกนและกรอกข้อมูลอัตโนมัติ</button>
          </div>
        </div>
        <small id="uploadStatus" class="text-muted d-block mt-2"></small>
      </div>

<!-- Section: สืบราคาท้องตลาดจาก -->
<div class="card-section mb-4">
  <div class="card-section-header">
    <i class="bi bi-search"></i> สืบราคาท้องตลาดจาก
  </div>
