function checkButtonStatus() {
    const btn = document.getElementById('btnAddRows');
    const msg = document.getElementById('rowLimitMsg');
    
    if (!btn) return; 

    if (currentRowCount >= MAX_ROWS) {
        btn.style.display = 'none'; 
