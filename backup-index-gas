// 🎯 3. สลับ Tab ประเภทเอกสาร (A, B, C, D)
// 🎯 ฟังก์ชันปรับประเภทเอกสารให้เป็นมาตรฐานเดียวกัน
function normalizeDocType(typeInput) {
  if (!typeInput) return 'po';
  const t = String(typeInput).trim().toLowerCase();
  if (t === 'b' || t === 'wo' || t.includes('จ้าง')) return 'wo';
  if (t === 'c' || t === 'fpo' || t.includes('น้ำมัน')) return 'fpo';
  return 'po';
}

// 🎯 ฟังก์ชันสลับ Tab
function switchPoTab(type, btnElement = null) {
  currentDocType = normalizeDocType(type);
  
  document.querySelectorAll('.nav-po-type').forEach(btn => btn.classList.remove('active'));
  if (btnElement) {
    btnElement.classList.add('active');
  } else if (window.event && window.event.currentTarget) {
    window.event.currentTarget.classList.add('active');
  }

  // เปลี่ยน Label ตามหมวดใหม่
  const labels = { 
    'po': '(ใบสั่งซื้อ)', 
    'wo': '(ใบสั่งจ้าง)', 
    'fpo': '(ใบสั่งซื้อน้ำมัน)'
  };
  const labelEl = document.getElementById('currentTypeLabel');
  if (labelEl) labelEl.innerText = labels[currentDocType] || '';

  // 🎯 Option: หากต้องการให้ดึงข้อมูลใหม่จาก Firestore ทุกครั้งที่กด Tab ให้ใช้ loadLogPoData();
  // แต่ถ้าต้องการกรองจากแคชในความจำทันที ให้ใช้ renderPoTable();
  renderPoTable();
}

// 🎯 แสดงข้อมูลในตาราง
function renderPoTable() {
  const tbody = document.getElementById('poDataTableBody');
  if (!tbody) return;

  const targetType = normalizeDocType(currentDocType);

  const filteredData = allPoLogs.filter(item => {
    if (!item) return false;
    
    // 1. เทียบ doc_type ผ่าน normalizeDocType เพื่อให้ครอบคลุมทุกรหัส (po, wo, fpo, a, b, c, ซื้อ, จ้าง)
    const itemType = normalizeDocType(item.doc_type);
    const isSameType = (itemType === targetType);
    
    // 2. เช็กรายละเอียดพัสดุจากทั้ง details หรือ objective
    const detailText = String(item.details || item.objective || '').trim();
    const hasDetails = detailText !== '' && detailText !== '-';

    return isSameType && hasDetails;
  });

  if (filteredData.length === 0) {
    tbody.innerHTML = `<tr><td colspan="9" class="py-4 text-muted"><i class="bi bi-inbox fs-3 d-block mb-1"></i>ไม่พบรายการที่มีข้อมูลรายละเอียดในหมวดนี้</td></tr>`;
    return;
  }

  // เรียงลำดับรายการล่าสุดขึ้นก่อน (ตาม pr_date, base_no, sub_no)
  filteredData.sort((a, b) => {
    const dateA = a.pr_date || '';
    const dateB = b.pr_date || '';
    if (dateA !== dateB) return dateB.localeCompare(dateA);
    return (Number(b.base_no) || 0) - (Number(a.base_no) || 0) || (Number(b.sub_no) || 0) - (Number(a.sub_no) || 0);
  });

  tbody.innerHTML = filteredData.map(item => {
    const detailText = item.details || item.objective || '-';
    return `
      <tr>
        <td><span class="badge bg-primary fs-6">${item.log_po || '-'}</span></td>
        <td>${item.pr_date || '-'}</td>
        <td class="text-start">${detailText}</td>
        <td>${item.seller || '-'}</td>
        <td class="text-end fw-bold">${Number(item.total || 0).toLocaleString('th-TH', {minimumFractionDigits: 2})}</td>
        <td>${item.division || '-'}</td>
        <td>${item.egp_no || '-'}</td>
        <td>
          ${item.is_manual 
            ? '<span class="badge bg-secondary">กรอกเอง</span>' 
            : '<span class="badge bg-success">KBSPAY</span>'}
        </td>
        <td>
          <button type="button" class="btn btn-sm btn-outline-info" onclick="viewPoDetail('${item.id}')" title="จัดการ / แก้ไข">
            <i class="bi bi-search"></i>
          </button>
        </td>
      </tr>
    `;
  }).join('');
}

