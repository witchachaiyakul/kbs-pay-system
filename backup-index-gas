            msg.style.color = 'red';
        }
    } else {
        btn.style.display = 'inline-block';
        if(msg) {
            msg.innerText = `แสดงอยู่ ${currentRowCount} รายการ (สูงสุด ${MAX_ROWS})`;
            msg.style.color = '#4a4a4a';
        }
    }
}
        
function calculateTotals() {
    let totalSubtotal = 0;
    let totalQuantity = 0;
            
    for (let i = 1; i <= MAX_ROWS; i++) {
        const qu = parseFloat(document.getElementById(`qu${i}`)?.value) || 0;
        const pr = parseFloat(document.getElementById(`pr${i}`)?.value) || 0;
        const amount = qu * pr;
                
        const amInput = document.getElementById(`am${i}`);
        if (amInput) amInput.value = formatMoney(amount);
                
        totalSubtotal += amount;
        totalQuantity += qu;
    }
            
    const vatType = document.querySelector('input[name="vat_type"]:checked')?.value || 'no_vat';
    let subtotal = 0; 
    let vat = 0;
    let grandTotal = 0;
            
    if (vatType === 'ex_vat') {
        subtotal = totalSubtotal;
        vat = subtotal * 0.07;
        grandTotal = subtotal + vat;
    } else if (vatType === 'in_vat') {
        grandTotal = totalSubtotal;
        subtotal = grandTotal / 1.07;
        vat = grandTotal - subtotal;
    } else { 
        subtotal = totalSubtotal;
        vat = 0;
        grandTotal = subtotal;
    }
            
    document.getElementById('cal_subtotal').value = formatMoney(subtotal);
    document.getElementById('cal_vat').value = formatMoney(vat);
    document.getElementById('cal_grandtotal').value = formatMoney(grandTotal);
    document.getElementById('cal_grandtotal').dataset.value = grandTotal.toFixed(2);

    calculateWithholdingTax(subtotal, grandTotal);
            
    const msgDiv = document.getElementById('validationMessage');
    if(msgDiv) msgDiv.innerText = "";
}

// 🎯 แก้ไขฟังก์ชันคำนวณภาษีหัก ณ ที่จ่าย ตามเงื่อนไขใหม่ของพี่
function calculateWithholdingTax(subtotal, grandTotal) {
    const taxId = (document.getElementById('tax_id')?.value || "").trim();
    const firstChar = taxId.charAt(0);
    
    let taxValue = subtotal; // value = ราคาสินค้า (ไม่รวม vat)
    let incomeTax = 0;
    
    if (!taxId) {
        // ถ้ายุ่งอยู่หรือยังไม่ได้กรอกเลขประจำตัว ให้เป็น 0 ไว้ก่อนครับ
        incomeTax = 0;
    } else if (firstChar === '0') { 
        // 🏢 1. กรณีนิติบุคคล (ขึ้นต้นด้วยเลข 0 เท่านั้น)
        if (grandTotal >= 501) {
            incomeTax = taxValue * 0.01; // ยอด 501 ขึ้นไป หัก 1%
        } else {
            incomeTax = 0; // ยอด 0-500 ไม่หัก
        }
    } else { 
        // 👤 2. กรณีบุคคลธรรมดา (นอกเหนือจากนั้นทั้งหมด ไม่ว่าจะขึ้นต้นด้วยเลขอะไร)
        if (grandTotal >= 10001) {
            incomeTax = taxValue * 0.01; // ยอด 10,001 ขึ้นไป หัก 1%
        } else {
            incomeTax = 0; // ยอด 0-10,000 ไม่หัก
        }
    }
    
    let actPaid = grandTotal - incomeTax;
    
    // พ่นค่าแสดงผลบนหน้าจอในระบบคำนวณบิล
    document.getElementById('cal_value').value = formatMoney(taxValue);
    document.getElementById('cal_income_tax').value = formatMoney(incomeTax);
    document.getElementById('cal_act_paid').value = formatMoney(actPaid);
}

function validateBudget() {
    const budgetUseText = document.getElementById('quantity').value.replace(/,/g, '');
    const budgetUse = parseFloat(budgetUseText) || 0;
    const grandTotal = parseFloat(document.getElementById('cal_grandtotal').dataset.value) || 0;
    const msgDiv = document.getElementById('validationMessage');
    const diff = Math.abs(budgetUse - grandTotal);
            
    if (currentBudget === null) {
        msgDiv.innerText = "⚠️ กรุณากรอก LOG NO. เพื่อตรวจสอบงบประมาณ";
        msgDiv.style.color = "orange";
        return false;
    }

    if (diff < 0.01) { 
        msgDiv.innerText = "✅ ถูกต้อง: ยอดรวมตรงกับงบที่ขอใช้";
        msgDiv.style.color = "green";
        return true;
    } else {
        let errorText = "❌ ไม่ถูกต้อง: ";
        if (grandTotal > budgetUse) errorText += `ยอดเกินงบ ${formatMoney(grandTotal - budgetUse)} บาท`;
        else errorText += `ยอดต่ำกว่างบ ${formatMoney(budgetUse - grandTotal)} บาท`;
        msgDiv.innerText = errorText;
        msgDiv.style.color = "red";
        return false;
    }
}

