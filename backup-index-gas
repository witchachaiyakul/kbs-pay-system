/**
 * ฟังก์ชันวาดแผนภูมิโดนัทสำหรับใส่ใน div การ์ดแต่ละใบ
 * @param {string} containerId - ID ของ div ที่ต้องการวาดกราฟ
 * @param {number} used - ยอดเงินที่ใช้ไปแล้ว
 * @param {number} remain - ยอดเงินคงเหลือ
 */
function renderDonutChart(containerId, used, remain) {
  const container = document.getElementById(containerId);
  if (!container) return;

  // กรณีไม่มีงบตั้งไว้เลย
  if (used <= 0 && remain <= 0) {
    container.innerHTML = '<div class="text-center text-muted pt-5 small">ไม่มีงบประมาณ</div>';
    return;
  }

  // สร้าง DataTable สำหรับ Google Charts
  const data = google.visualization.arrayToDataTable([
    ['สถานะ', 'จำนวนเงิน'],
    ['ใช้ไปแล้ว', used],
    ['คงเหลือ', remain]
  ]);

  // ตั้งค่ารูปแบบแผนภูมิโดนัท
  const options = {
    pieHole: 0.55, // กำหนดความกว้างรูตรงกลาง (เป็นโดนัท)
    colors: ['#F09819', '#1A2980'], // สีแดง (ใช้ไป) / สีเขียว (คงเหลือ)
    legend: { position: 'bottom', textStyle: { fontSize: 11 } },
    chartArea: { width: '90%', height: '75%' },
    tooltip: { text: 'value' },
    backgroundColor: 'transparent'
  };

  const chart = new google.visualization.PieChart(container);
  chart.draw(data, options);
}

