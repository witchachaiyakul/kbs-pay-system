// log_po
/**
 * 🎯 ฟังก์ชันออกเลข PO/WO/FPO อัตโนมัติ (รองรับการกรอกวันที่ย้อนหลังฉลาดขึ้น)
 */
/**
 * 🎯 ฟังก์ชันออกเลข PO/WO/FPO อัตโนมัติ (แก้ไขบั๊ก sub_no = 0)
 * - ลำดับแรกของวัน: base_no = 214, sub_no = 0 -> ได้เลข "214/2569"
 * - ลำดับที่ 2 ของวัน: base_no = 214, sub_no = 1 -> ได้เลข "214/1/2569"
 * - ลำดับที่ 3 ของวัน: base_no = 214, sub_no = 2 -> ได้เลข "214/2/2569"
 */
function generateLogPoNumber(docTypeInput, prDateStr, existingLogs = [], holidayList = []) {
  const docType = typeof normalizeDocType === 'function' ? normalizeDocType(docTypeInput) : (docTypeInput || 'po');
  const prDate = prDateStr ? new Date(prDateStr) : new Date();
  const yearBE = prDate.getFullYear() + 543;
  const targetDateStr = prDateStr || new Date().toISOString().split('T')[0];

  // 🎯 Helper ฟังก์ชันสำหรับดึงค่า sub_no ให้ถูกต้องแม้ค่าเดิมจะเป็น 0
  const getSubNo = (item) => {
    if (!item) return 0;
    if (item.sub_no !== undefined && item.sub_no !== null && item.sub_no !== '') return Number(item.sub_no);
    if (item.po_sub_no !== undefined && item.po_sub_no !== null && item.po_sub_no !== '') return Number(item.po_sub_no);
    return 0;
  };

  const getBaseNo = (item) => {
    if (!item) return 1;
    return Number(item.base_no || item.po_base_no) || 1;
  };

  // 1. กรองเฉพาะหมวดและปีเดียวกัน
  const sameTypeAndYearLogs = existingLogs.filter(item => {
    if (!item) return false;
    const itemType = typeof normalizeDocType === 'function' ? normalizeDocType(item.doc_type) : item.doc_type;
    const itemYear = Number(item.year_be || item.po_year_be) || 0;
    let y = itemYear;
    if (y === 0 && item.pr_date) y = new Date(item.pr_date).getFullYear() + 543;
    return itemType === docType && (y === 0 || y === yearBE);
  });

  // ถ้ายังไม่มีข้อมูลในระบบเลย ให้เริ่มต้นที่ base_no = 1, sub_no = 0
  if (sameTypeAndYearLogs.length === 0) {
    return {
      log_po: `1/${yearBE}`,
      base_no: 1,
      sub_no: 0,
      year_be: yearBE,
      doc_type: docType
    };
  }

  // 🎯 2. ตรวจสอบว่าในวันที่เลือก (targetDateStr) มีรายการในระบบอยู่แล้วหรือไม่
  const sameDateLogs = sameTypeAndYearLogs.filter(item => item.pr_date === targetDateStr);

  if (sameDateLogs.length > 0) {
    // 📌 มีรายการในวันเดียวกัน -> หา sub_no ที่มากที่สุดของวันนั้น
    sameDateLogs.sort((a, b) => getSubNo(b) - getSubNo(a));
    const maxSameDate = sameDateLogs[0];
    const baseNo = getBaseNo(maxSameDate);
    const maxSubNo = getSubNo(maxSameDate);
    
    // 🎯 ลำดับถัดมา: ถ้าเดิมเป็น 0 จะได้ 0 + 1 = 1 (ได้เลข 214/1/2569)
    const newSubNo = maxSubNo + 1; 

    return {
      log_po: `${baseNo}/${newSubNo}/${yearBE}`,
      base_no: baseNo,
      sub_no: newSubNo,
      year_be: yearBE,
      doc_type: docType
    };
  }

  // 🎯 3. ถ้าวันนั้นยังไม่มีรายการ ให้หารายการล่าสุดก่อนหน้านั้น
  const pastLogs = sameTypeAndYearLogs.filter(item => item.pr_date && item.pr_date <= targetDateStr);

  if (pastLogs.length > 0) {
    pastLogs.sort((a, b) => {
      if (a.pr_date !== b.pr_date) return a.pr_date.localeCompare(b.pr_date);
      return getBaseNo(a) - getBaseNo(b);
    });

    const lastPast = pastLogs[pastLogs.length - 1];
    const lastBaseNo = getBaseNo(lastPast);
    
    // คำนวณวันทำการ
    const workingDays = typeof countWorkingDaysBetween === 'function'
      ? countWorkingDaysBetween(lastPast.pr_date, targetDateStr, holidayList)
      : 1;

    const newBaseNo = lastBaseNo + (workingDays > 0 ? workingDays : 1);
    
    // 🎯 รายการแรกของวันใหม่ sub_no ต้องเริ่มต้นที่ 0
    return {
      log_po: `${newBaseNo}/${yearBE}`,
      base_no: newBaseNo,
      sub_no: 0,
      year_be: yearBE,
      doc_type: docType
    };
  } else {
    // กรณีเลือกวันที่เก่ากว่าประวัติทั้งหมดที่มี
    return {
      log_po: `1/${yearBE}`,
      base_no: 1,
      sub_no: 0,
      year_be: yearBE,
      doc_type: docType
    };
  }
}
