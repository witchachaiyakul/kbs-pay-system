// ============================================================================
// 1. ฟังก์ชันออกเลข นผ.2 อัตโนมัติ (นผ2 + MM + YY + NNNN)
// ============================================================================
function getNextLogNo() {
  const now = new Date();
  
  // ดึงเดือน 2 หลัก (01-12) และ ปี พ.ศ. 2 หลักสุดท้าย (เช่น 69)
  const monthStr = String(now.getMonth() + 1).padStart(2, '0');
  const thaiYearFull = now.getFullYear() + 543;
  const yearStr = String(thaiYearFull).slice(-2);

  // ตั้งชื่อ Doc ID ตาม ปี+เดือน (เช่น "6908") เพื่อแยกรันลำดับรายเดือน
  const docId = `${yearStr}${monthStr}`;
  const docPath = `log_no/${docId}`;

  // อ่านลำดับล่าสุดจาก Firestore
  const res = callFirestore("GET", docPath);
  let lastNum = 0;

  if (res && res.fields) {
    const data = parseFirestoreFields(res.fields);
    lastNum = Number(data.last_number || 0);
  }

  // เพิ่มลำดับ +1
  const nextNum = lastNum + 1;

  // บันทึกลำดับล่าสุดกลับไปที่ log_no/{docId}
  const updateData = {
    last_number: nextNum,
    month: monthStr,
    year: yearStr,
    updated_at: now.toString()
  };
  
  const updateMask = "updateMask.fieldPaths=last_number&updateMask.fieldPaths=month&updateMask.fieldPaths=year&updateMask.fieldPaths=updated_at";
  callFirestore("PATCH", `${docPath}?${updateMask}`, buildFirestorePayload(updateData));

  // ประกอบร่างเป็น นผ2 + MM + YY + ลำดับ 4 หลัก (เช่น นผ208690005)
  const paddedSeq = String(nextNum).padStart(4, '0');
  return `นผ2${monthStr}${yearStr}${paddedSeq}`;
}

// ============================================================================
// 2. ฟังก์ชันรับข้อมูลจาก submitDisbursePlanDoc บันทึกตัดจ่ายและอัปเดตงบ
// ============================================================================
function saveDisbursePlanRequest(payload) {
  try {
    const projectId = String(payload.project_id || '').trim();
    const amount = Number(payload.amount || 0);

    if (!projectId || amount <= 0) {
      return { success: false, message: "ข้อมูลรหัสโครงการหรือจำนวนเงินไม่ถูกต้อง" };
    }

    // 1. ดึงข้อมูลโครงการปัจจุบันจาก budget_plans
    const planRes = callFirestore("GET", `budget_plans/${projectId}`);
    if (!planRes || !planRes.fields) {
      return { success: false, message: `ไม่พบโครงการรหัส ${projectId}` };
    }

    const currentPlan = parseFirestoreFields(planRes.fields);
    const oldUsedBudget = Number(currentPlan.used_budget || 0);
    const oldRemainBudget = Number(currentPlan.remaining_budget || 0);

    if (oldRemainBudget < amount) {
      return { success: false, message: "ยอดเงินคงเหลือไม่เพียงพอต่อการตัดจ่าย" };
    }

    // 2. คำนวณยอดเงินใหม่
    const balanceBefore = oldRemainBudget;
    const balanceAfter = balanceBefore - amount;
    const newUsedBudget = oldUsedBudget + amount;
    const newRemainBudget = balanceAfter;

    // 🎯 3. เรียกใช้ออกเลข นผ.2 อัตโนมัติที่ตรงนี้
    const logNo = getNextLogNo(); 

    // 4. เตรียมข้อมูลบันทึกลง log_budget
    const logPayloadData = {
      log_no: logNo,
      project_id: projectId,
      date: new Date().toString(),
      method: String(payload.purchase_type || '-').trim(),
      requested_by: String(payload.applicant || '-').trim(),
      details: String(payload.remark || '-').trim(),
      balance_before: balanceBefore,
      budget_use: amount,
      balance_after: balanceAfter,
      status: "active"
    };

    // 5. เตรียมข้อมูลอัปเดต budget_plans
    const updatePlanData = {
      used_budget: newUsedBudget,
      remaining_budget: newRemainBudget
    };

    // 6. บันทึกลง Firestore (log_budget และ budget_plans)
    callFirestore("PATCH", `log_budget/${logNo}`, buildFirestorePayload(logPayloadData));
    
    const planMask = "updateMask.fieldPaths=used_budget&updateMask.fieldPaths=remaining_budget";
    callFirestore("PATCH", `budget_plans/${projectId}?${planMask}`, buildFirestorePayload(updatePlanData));

    return { 
      success: true, 
      message: "บันทึกตัดจ่ายสำเร็จ",
      log_no: logNo,
      new_remaining: newRemainBudget 
    };

  } catch (error) {
    return { success: false, message: error.toString() };
  }
}

// 🎯 ฟังก์ชันยืนยันตัดจ่าย และแสดง Pop-up สำเร็จ
function submitDisbursePlanDoc() {
