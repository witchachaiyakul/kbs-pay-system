// ============================================================================
// 🧹 FUNCTION: BATCH DELETE INCOMPLETE / GHOST DOCS IN LOG_BUDGET
// ============================================================================
function cleanIncompleteLogBudgetDocsBatch() {
  try {
    Logger.log("⏳ กำลังค้นหาเอกสารที่ไม่สมบูรณ์ใน collection: log_budget...");
    
    // 1. ดึงเอกสารทั้งหมดใน log_budget
    const resDocs = callFirestore("GET", "log_budget?pageSize=1000");
    if (!resDocs || !resDocs.documents || !Array.isArray(resDocs.documents)) {
      Logger.log("❌ ไม่พบเอกสารใดๆ ใน collection log_budget");
      return;
    }

    const writes = [];
    let keepCount = 0;

    // 2. วนลูปตรวจสอบเอกสารเพื่อรวบรวมรายการลบ
    resDocs.documents.forEach(doc => {
      // doc.name คือ Resource Name เต็มของ Firestore เช่น projects/{projectId}/databases/(default)/documents/log_budget/...
      const docName = doc.name;
      const rawDocId = docName.split('/documents/log_budget/')[1] || '';
      const fields = doc.fields ? parseFirestoreFields(doc.fields) : {};
      
      // 🎯 เงื่อนไขการลบ:
      // 1) Doc ID มี % (เกิดจากรหัส encode ภาษาไทยเพี้ยน)
      // 2) ไม่มีข้อมูล date, details และ budget_use (มียอดเป็น 0 หรือว่างเปล่า)
      const isUrlEncodedId = rawDocId.includes('%');
      const isIncomplete = !fields.date && !fields.details && (!fields.budget_use || fields.budget_use === 0);

      if (isUrlEncodedId || isIncomplete) {
        // ใช้ doc.name ใส่ในวัตถุ { delete: ... } สำหรับ Firestore Batch REST API
        writes.push({ delete: docName });
        Logger.log(`🗑️ เตรียมลบ: ${rawDocId}`);
      } else {
        keepCount++;
      }
    });

    // 3. ยิง Batch Delete สั่งลบทีเดียว
    if (writes.length > 0) {
      Logger.log(`⏳ กำลังส่ง Batch Delete ลบเอกสารขยะจำนวน ${writes.length} รายการ...`);
      commitBatchToFirestore(writes);
      Logger.log(`🎉 ลบเอกสารขยะเสร็จสิ้น! ลบไปทั้งหมด: ${writes.length} รายการ | คงเหลือรายการสมบูรณ์: ${keepCount} รายการ`);
    } else {
      Logger.log("✨ ไม่พบเอกสารขยะที่ต้องลบ");
    }

  } catch (error) {
    Logger.log("❌ เกิดข้อผิดพลาดในการรัน Batch Delete: " + error.toString());
  }
}

