// 📄 ฟังก์ชันสร้างเอกสาร GOOGLE DOC (สลับ Template อัตโนมัติ)
// ============================================================================
function createGoogleDoc(docData) {
    try {
        const fileName = `${docData.seller || 'Doc'}_${docData.total || 'NoAmt'}_${new Date().getTime()}`;
        
        // 🎯 แปลงเป็น Number และทำ Fallback รองรับทั้ง itemCount, quantity หรือความยาวของอาเรย์ items
        const itemCount = Number(docData.itemCount || docData.quantity || (docData.items ? docData.items.length : 0)) || 0;
        const prType = String(docData.PR_TYPE || docData.pr_type || docData.method || 'ซื้อ').trim(); 

        // 🎯 ลอจิกเลือก Template: 1-19 รายการ ใช้ _19 / 20-29 รายการ (เกิน 19) ใช้ _29
        let selectedTemplateId;

        if (prType.includes('จ้าง')) {
            // 🛠️ กรณีงานจ้าง (WO)
            selectedTemplateId = (itemCount > 19) ? WORK_FORM_29 : WORK_FORM_19;
        } else {
            // 🛒 กรณีงานซื้อ (PO / FPO)
            selectedTemplateId = (itemCount > 19) ? BUY_FORM_29 : BUY_FORM_19;
        }

        const templateFile = DriveApp.getFileById(selectedTemplateId);
        const targetFolder = DriveApp.getFolderById(FOLDER_ID);

        const copyFile = templateFile.makeCopy(fileName, targetFolder);
        const newFileId = copyFile.getId();

        Utilities.sleep(1000);

        let doc; 
        let attempt = 0; 
        let success = false;
        let lastError = "";

        while (attempt < 5 && !success) {
            try {
                attempt++; 
                doc = DocumentApp.openById(newFileId); 
                success = true; 
            } catch (err) { 
                lastError = err.message;
                Utilities.sleep(1500); 
            }
        }

        if (!success) {
            throw new Error(`ไม่สามารถเปิดไฟล์เพื่อเขียนข้อมูลได้ (${lastError})`);
        }

        const body = doc.getBody();
        fillCommonData(body, docData);
        fillDateData(body, docData);
        fillCommitteeData(body, docData);
        fillItemAndMoneyData(body, docData);
        fillItemDetails(body, docData);

        doc.saveAndClose();

        try {
            copyFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
        } catch (shareErr) {
            Logger.log("⚠️ ปรับสิทธิ์แชร์ไม่สำเร็จ (ติดนโยบายโดเมน): " + shareErr.message);
        }

        const finalDocUrl = copyFile.getUrl();
        const wordDownloadUrl = `https://docs.google.com/document/d/${newFileId}/export?format=docx`;
        const pdfDownloadUrl = `https://docs.google.com/document/d/${newFileId}/export?format=pdf`;

        return { 
            status: 'success', 
            docUrl: finalDocUrl, 
            wordDownloadUrl: wordDownloadUrl,
            pdfDownloadUrl: pdfDownloadUrl,
            message: 'สร้างเอกสารเรียบร้อย' 
        };

    } catch (e) {
        return { status: 'error', message: e.message };
    }
}

