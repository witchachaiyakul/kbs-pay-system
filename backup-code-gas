      const sellerName  = String(row[0] || '').trim();  // Col A: seller (ชื่อผู้ขาย/ร้านค้า)
      const adNo        = String(row[1] || '').trim();  // Col B: ad_no (บ้านเลขที่/ที่อยู่)
      const adM         = String(row[2] || '').trim();  // Col C: ad_m (หมู่)
      const adRd        = String(row[3] || '').trim();  // Col D: ad_rd (ถนน)
      const adTb        = String(row[4] || '').trim();  // Col E: ad_tb (ตำบล)
      const adMu        = String(row[5] || '').trim();  // Col F: ad_mu (อำเภอ)
      const adPr        = String(row[6] || '').trim();  // Col G: ad_pr (จังหวัด)
      const postid      = Number(row[7]) || 0;          // Col H: postid (รหัสไปรษณีย์)
      const adPh        = String(row[8] || '').trim();  // Col I: ad_ph (เบอร์โทรศัพท์)
      const taxId       = String(row[9] || '').trim();  // Col J: taxid (เลขผู้เสียภาษี)
      const bidderName  = String(row[10] || '').trim(); // Col K: bidder_name (ชื่อผู้แทน/ผู้ยื่น)
      const invoiceType = String(row[11] || '').trim(); // Col L: invoice_type (ประเภทใบเสร็จ)

      // ข้ามแถวที่ไม่มีชื่อร้านค้า
      if (!sellerName) return;

      // 🎯 กำหนด Document ID: ใช้ taxid (Col J) ก่อน ถ้าไม่มีใช้ชื่อร้านค้า
      let docId = "";
      if (taxId && taxId !== '-' && taxId.length >= 10) {
        docId = taxId;
      } else {
        docId = sellerName.replace(/[\s\/\.\,\-\(\)\u00A0]+/g, '');
      }

      // Fallback ป้องกันกรณี ID เป็นค่าว่าง
      if (!docId) {
        docId = `sup_${i + 1}`;
      }

      writes.push(buildWriteObject(keyFile.project_id, `suppliers/${docId}`, {
        seller: sellerName,
        ad_no: adNo,
        ad_m: adM,
        ad_rd: adRd,
        ad_tb: adTb,
        ad_mu: adMu,
        ad_pr: adPr,
        postid: postid,
        ad_ph: adPh,
        taxid: taxId,
        bidder_name: bidderName,
        invoice_type: invoiceType
      }));
    });

    if (writes.length > 0) {
      // แบ่งทยอยบันทึกครั้งละ 400 รายการ ป้องกัน Firestore REST Limit 500
      const BATCH_SIZE = 400;
      for (let i = 0; i < writes.length; i += BATCH_SIZE) {
        const chunk = writes.slice(i, i + BATCH_SIZE);
        commitBatchToFirestore(chunk);
      }
      Logger.log(`🎉 ย้ายข้อมูลผู้ขายจากชีท 'sup' สำเร็จแล้วทั้งหมด ${writes.length} รายการ`);
    } else {
      Logger.log("⚠️ ไม่พบข้อมูลผู้ขายในชีท 'sup'");
    }

  } catch (err) {
    Logger.log("❌ Error migrateSuppliersFromSheetSup: " + err);
  }
}

