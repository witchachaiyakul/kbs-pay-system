      };

      const cleanPayload = typeof sanitizeObject === 'function' ? sanitizeObject(rawPayload) : rawPayload;

      // 🎯 Document ID รูปแบบใหม่: fpo_101_1_2569
      const safeDocId = `${docType}_${baseNo}_${subNo}_${yearBE}`;
      const docPath = `log_po/${safeDocId}`;

      writes.push(buildWriteObject(projectId, docPath, cleanPayload));
      processedCount++;

      // สรุปค่า Counter สำหรับ fpo_2569
      const counterKey = `${docType}_${yearBE}`;
      if (!counterTracker[counterKey]) {
        counterTracker[counterKey] = {
          doc_type: docType,
          year_be: yearBE,
          last_base_no: baseNo,
          last_sub_no: subNo,
          last_pr_date: prDateFormatted || ""
        };
      } else {
        const current = counterTracker[counterKey];
        if (baseNo > current.last_base_no) {
          current.last_base_no = baseNo;
          current.last_sub_no = subNo;
          if (prDateFormatted > current.last_pr_date) {
            current.last_pr_date = prDateFormatted;
          }
        } else if (baseNo === current.last_base_no) {
          if (subNo > current.last_sub_no) {
            current.last_sub_no = subNo;
          }
          if (prDateFormatted > current.last_pr_date) {
            current.last_pr_date = prDateFormatted;
          }
        }
      }
    });

    // บันทึกลงคอลเลกชัน po_counters (เช่น po_counters/fpo_2569)
    Object.keys(counterTracker).forEach(key => {
      const cData = counterTracker[key];
      const counterPayload = typeof sanitizeObject === 'function' ? sanitizeObject({
        ...cData,
        updated_at: new Date().toISOString()
      }) : { ...cData, updated_at: new Date().toISOString() };
      
      const counterPath = `po_counters/${key}`;
      writes.push(buildWriteObject(projectId, counterPath, counterPayload));
    });

    Logger.log(`🔍 สรุปการอ่านข้อมูล [fpo]: พบรายการที่ประมวลผล ${processedCount} รายการ / ข้าม ${skippedCount} รายการ`);

    if (writes.length > 0) {
      Logger.log(`⏳ กำลังทยอยนำเข้าข้อมูลหมวด fpo ทั้งหมด ${writes.length} คำสั่ง (แบ่ง Batch ละ 400)...`);
      
      const BATCH_SIZE = 400;
      for (let i = 0; i < writes.length; i += BATCH_SIZE) {
        const chunk = writes.slice(i, i + BATCH_SIZE);
        commitBatchToFirestore(chunk);
        Logger.log(`  └─ บันทึกสำเร็จกลุ่มที่ ${Math.floor(i / BATCH_SIZE) + 1} (${chunk.length} รายการ)`);
      }

      Logger.log(`🎉 ย้ายข้อมูลหมวด fpo สำเร็จทั้งหมด! สร้าง Document ใน log_po และ po_counters (prefix: fpo) เรียบร้อยแล้ว`);
    } else {
      Logger.log("❌ ไม่พบรายการข้อมูลที่ถูกต้องสำหรับนำเข้าในชีท 3");
    }

  } catch (error) {
    Logger.log("❌ เกิดข้อผิดพลาด: " + error.toString());
  }
}


// ============================================================================
// 🚀 FUNCTION: UNIFIED MIGRATION LOG_BUDGET WITH PROJECT_ID (BATCH WRITE)
// ============================================================================
function migrateLogBudgetToFirestore() {
  try {
    const scriptProperties = PropertiesService.getScriptProperties();
    const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
    const projectId = keyFile.project_id;

    const spreadsheetId = "1tPiyIggb0Y6N6LLcbGHy49_507ECaEro9zeGI8igSpw"; // Spreadsheet ID ต้นทาง
    const sheetName = "Log"; // ระบุชื่อชีทประวัติการตัดแผน

    // ⚙️ กำหนดขอบเขตแถวที่ต้องการประมวลผล
    const START_ROW = 497;
    const END_ROW = 508;

    // ------------------------------------------------------------------------
    // 1. ดึงข้อมูล Master Plan จาก Firestore budget_plans เพื่อทำ Lookup Map
    // ------------------------------------------------------------------------
    Logger.log("⏳ กำลังดึงข้อมูลจาก Firestore collection: budget_plans...");
    const planRes = callFirestore("GET", "budget_plans?pageSize=1000");
    
    if (!planRes || !planRes.documents || !Array.isArray(planRes.documents)) {
      Logger.log("❌ ไม่พบข้อมูลใน collection budget_plans");
      return;
    }

    const planMap = new Map();
    planRes.documents.forEach(doc => {
      if (doc.fields) {
        const item = parseFirestoreFields(doc.fields);
        const pName = String(item.project_name || '').trim();
        const aName = String(item.activity_name || '').trim();
        const pId = String(item.project_id || '').trim();

        if (pName && aName && pId) {
          const key = `${pName}|||${aName}`;
          planMap.set(key, pId);
        }
      }
    });

    Logger.log(`✅ โหลดข้อมูล budget_plans สำเร็จ (${planMap.size} รายการ)`);

    // ------------------------------------------------------------------------
    // 2. ดึงข้อมูลจาก Google Sheet แผ่น Log เฉพาะแถวที่กำหนด (497 ถึง 508)
    // ------------------------------------------------------------------------
    const ss = SpreadsheetApp.openById(spreadsheetId);
    const sheet = ss.getSheetByName(sheetName);

    if (!sheet) {
      Logger.log("❌ ไม่พบชีทชื่อ: " + sheetName);
      return;
    }

    const maxRows = sheet.getLastRow();
    if (maxRows < START_ROW) {
      Logger.log(`⚠️ ข้อมูลในชีทมีเพียง ${maxRows} แถว (น้อยกว่าแถวเริ่มต้นที่ ${START_ROW})`);
      return;
    }

    // คำนวณจำนวนแถวที่ต้องการอ่านข้อมูล
    const targetEndRow = Math.min(END_ROW, maxRows);
    const numRows = targetEndRow - START_ROW + 1;

    // ดึงเฉพาะช่วง Cell ที่กำหนด (แถวเริ่มต้น, คอลัมน์แรก, จำนวนแถว, คอลัมน์สุดท้าย)
    const rows = sheet.getRange(START_ROW, 1, numRows, sheet.getLastColumn()).getValues();
    const writes = [];
    let matchedIdCount = 0;
    let unmatchedIdCount = 0;

    // ฟังก์ชันแปลงตัวเลขทางการเงิน
    const parseNum = (val) => {
      if (typeof val === 'number') return val;
      if (!val) return 0;
      const cleaned = String(val).replace(/,/g, '').trim();
      return parseFloat(cleaned) || 0;
    };

    // ------------------------------------------------------------------------
    // 3. วนลูปอ่านข้อมูลและประกอบ Payload + project_id
    // ------------------------------------------------------------------------
    rows.forEach((row, index) => {
      const currentRowNum = START_ROW + index;           // เลขแถวจริงใน Sheet (เช่น 497, 498, ...)
      const logNo = String(row[0] || '').trim();         // คอลัมน์ A: log NO (ใช้เป็น Doc ID)
      const sheetProjName = String(row[3] || '').trim(); // คอลัมน์ D: project_name
      const sheetActName = String(row[4] || '').trim();  // คอลัมน์ E: activity_name

      if (!logNo) return;

      // ค้นหา project_id จาก Map
      const lookupKey = `${sheetProjName}|||${sheetActName}`;
      const matchedProjectId = planMap.get(lookupKey) || "";

      if (matchedProjectId) {
        matchedIdCount++;
      } else {
        unmatchedIdCount++;
        Logger.log(`⚠️ [แถวที่ ${currentRowNum}] ไม่พบ project_id ที่ตรงกับ: "${sheetProjName}" - "${sheetActName}" (log_no: ${logNo})`);
      }

      // สร้างวัตถุข้อมูลครบทุก Field รวม project_id
      const payloadData = {
        log_no: logNo,                               // คอลัมน์ A: เลข นผ.2
        project_id: matchedProjectId,                // project_id ที่จับคู่เจอ
        date: String(row[1] || '').trim(),           // คอลัมน์ B: วันที่
        balance_before: parseNum(row[7]),            // คอลัมน์ H: ใช้ไปแล้ว (ก่อนตัด)
        budget_use: parseNum(row[8]),                // คอลัมน์ I: ขอใช้ครั้งนี้
        balance_after: parseNum(row[9]),             // คอลัมน์ J: คงเหลือ (หลังตัด)
        method: String(row[10] || '').trim(),        // คอลัมน์ K: วิธีการ
        requested_by: String(row[11] || '').trim(),   // คอลัมน์ L: ผู้ขอใช้งบประมาณ
        details: String(row[12] || '').trim(),       // คอลัมน์ M: รายละเอียด
        status: "active"                             // สถานะรายการ
      };

      // ใช้ logNo ตรงๆ (ไม่ใช้ encodeURIComponent เพื่อป้องกันปัญหาชื่อ Doc ID เป็น %E0%B8%...)
      const docPath = `log_budget/${logNo}`;
      const writeObj = buildWriteObject(projectId, docPath, payloadData);
      writes.push(writeObj);
    });

    // ------------------------------------------------------------------------
    // 4. บันทึกเข้า Firestore ในรูปแบบ Batch Write (ก้อนเดียว)
    // ------------------------------------------------------------------------
    if (writes.length > 0) {
      Logger.log(`⏳ กำลังส่งบันทึก Batch Write ทั้งหมด ${writes.length} รายการ...`);
      commitBatchToFirestore(writes);
      Logger.log(`🎉 ย้ายข้อมูล log_budget พร้อม project_id เสร็จสิ้นเรียบร้อย!`);
    } else {
      Logger.log("⚠️ ไม่พบรายการข้อมูลที่ต้องย้าย");
    }

    Logger.log(`📊 สรุปผลการทำงานช่วงแถว ${START_ROW}-${targetEndRow} -> ทั้งหมด: ${writes.length} รายการ | จับคู่ project_id เจอ: ${matchedIdCount} รายการ | ไม่พบ project_id: ${unmatchedIdCount} รายการ`);

  } catch (error) {
    Logger.log("❌ เกิดข้อผิดพลาดในการนำเข้าข้อมูล: " + error.toString());
  }
}

