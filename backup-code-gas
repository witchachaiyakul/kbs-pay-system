// 🎯 1. ดึงข้อมูล log_po ทั้งหมดส่งกลับหน้าบ้าน
function getLogPoDataFromFirestore() {
  try {
    let allDocuments = [];
    let pageToken = "";

    do {
      let url = "log_po?pageSize=300";
      if (pageToken) {
        url += "&pageToken=" + encodeURIComponent(pageToken);
      }

      const res = callFirestore("GET", url);
      if (res && res.documents && Array.isArray(res.documents)) {
        allDocuments = allDocuments.concat(res.documents);
      }
      
      pageToken = (res && res.nextPageToken) ? res.nextPageToken : "";
    } while (pageToken);

    return allDocuments.map(doc => {
      const data = parseFirestoreFields(doc.fields || {});
      const docId = doc.name.split('/').pop();
      return { id: docId, ...data };
    });
  } catch (err) {
    Logger.log("❌ Error getLogPoDataFromFirestore: " + err);
    return [];
  }
}

