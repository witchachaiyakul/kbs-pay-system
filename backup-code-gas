function saveLogPoToFirestore(poData, docId) {
  try {
    if (!poData || !docId) {
      return { success: false, error: 'ข้อมูลไม่สมบูรณ์ (Missing poData or docId)' };
    }

    // 🎯 แปลงชนิดข้อมูลให้ถูกต้องก่อนบันทึก
    const cleanData = {
      ...poData,
      base_no: Number(poData.base_no) || 0,
      sub_no: Number(poData.sub_no) || 0,
      year_be: Number(poData.year_be) || (new Date().getFullYear() + 543),
      total: Number(String(poData.total || 0).replace(/,/g, '')) || 0,
      postid: Number(poData.postid) || 0,
      seller2: poData.seller2 || '',
      seller3: poData.seller3 || '',
      updated_at: new Date().toISOString()
    };

    const payload = toFirestoreFields(cleanData);
    
    // 1. บันทึกข้อมูลลงคอลเลกชัน log_po
    const res = callFirestore("PATCH", `log_po/${docId}`, payload);
    
    // 2. อัปเดตข้อมูลตัวนับ (Counter) อย่างปลอดภัย
    updatePoCounter(cleanData.doc_type, cleanData.year_be, cleanData.base_no, cleanData.sub_no, cleanData.pr_date);

    return { success: true, res: res };
  } catch (err) {
    Logger.log("❌ Error saveLogPoToFirestore: " + err);
    return { success: false, error: err.toString() };
  }
}

function updatePoCounter(docType, yearBe, baseNo, subNo, prDate) {
  try {
    const counterDocId = `${docType}_${yearBe}`;
    const newBase = Number(baseNo) || 0;
    const newSub = Number(subNo) || 0;

    // ดึงค่า Counter เดิมมาตรวจสอบก่อน
    let currentCounter = null;
    try {
      const res = callFirestore("GET", `po_counters/${counterDocId}`);
      if (res && res.fields) {
        currentCounter = parseFirestoreFields(res.fields);
      }
    } catch (e) {
      // หากยังไม่มี Document Counter เดิม ให้สร้างใหม่ได้เลย
    }

    let shouldUpdate = false;
    if (!currentCounter) {
      shouldUpdate = true;
    } else {
      const currBase = Number(currentCounter.last_base_no) || 0;
      const currSub = Number(currentCounter.last_sub_no) || 0;

      if (newBase > currBase) {
        shouldUpdate = true;
      } else if (newBase === currBase && newSub >= currSub) {
        shouldUpdate = true;
      }
    }

    if (shouldUpdate) {
      const counterData = {
        doc_type: docType,
        year_be: Number(yearBe),
        last_base_no: newBase,
        last_sub_no: newSub,
        last_pr_date: prDate || "",
        updated_at: new Date().toISOString()
      };

      callFirestore("PATCH", `po_counters/${counterDocId}`, toFirestoreFields(counterData));
      Logger.log(`✅ อัปเดต po_counter [${counterDocId}] เป็น base_no: ${newBase}, sub_no: ${newSub}`);
    }
  } catch (err) {
    Logger.log("⚠️ Warning updatePoCounter: " + err);
  }
}

// 🎯 5. อัปเดตข้อมูลเอกสาร log_po ที่มีอยู่แล้วใน Firestore
function updateLogPoInFirestore(docId, poData) {
  try {
    if (!docId || !poData) {
      return { success: false, error: 'ไม่ได้ระบุ docId หรือ poData' };
    }

    // 🎯 ทำความสะอาดข้อมูลและแปลงประเภทตัวเลขให้ถูกต้อง
    const cleanData = {
      ...poData,
      total: Number(String(poData.total || 0).replace(/,/g, '')) || 0,
      postid: Number(poData.postid) || 0,
      seller2: poData.seller2 || '',
      seller3: poData.seller3 || '',
      updated_at: new Date().toISOString()
    };

    const payload = toFirestoreFields(cleanData);
    
    // PATCH ไปที่ log_po/{docId} เพื่ออัปเดตข้อมูล
    const res = callFirestore("PATCH", `log_po/${docId}`, payload);
    
    return { success: true, res: res };
  } catch (err) {
    Logger.log("❌ Error updateLogPoInFirestore: " + err);
    return { success: false, error: err.toString() };
  }
}

