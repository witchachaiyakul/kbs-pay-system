function safeReplace(body, tag, value) {
    var strValue = (value === null || value === undefined) ? "" : String(value);
    // ป้องกันการตีความสัญลักษณ์ $ ผิดพลาดใน DocumentApp.replaceText
    strValue = strValue.replace(/\$/g, '$$$$'); 
    var escapedTag = tag.replace(/[\-\[\]\/\{\}\(\)\*\+\?\.\\\^\$\|]/g, "\\$&");
    body.replaceText(escapedTag, strValue);
}

