// 🎯 1. ฟังก์ชันดึงข้อมูลคอลเลกชัน suppliers ทั้งหมดส่งกลับเป็น Array
function getSuppliersFromFirestore() {
  try {
    const res = callFirestore("GET", "suppliers?pageSize=1000");
    if (!res || !res.documents || !Array.isArray(res.documents)) {
      Logger.log("⚠️ ไม่พบข้อมูลในคอลเลกชัน suppliers");
      return [];
    }

    return res.documents.map(doc => {
      const data = parseFirestoreFields(doc.fields || {});
      const docId = doc.name.split('/').pop();
      return { id: docId, ...data };
    });
  } catch (err) {
    Logger.log("❌ Error getSuppliersFromFirestore: " + err);
    return [];
  }
}

