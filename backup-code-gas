// ============================================================================
// 🚚 MIGRATION SCRIPT (BATCH COMMIT - ย้ายข้อมูลทีเดียวพร้อมกัน)
// ============================================================================
// 📌 ฟังก์ชันช่วยแปลงข้อมูลให้อยู่ในรูปแบบ Batch Write ของ Firestore REST API
function buildWriteObject(projectId, docPath, dataObj) {
  return {
    update: {
      name: `projects/${projectId}/databases/(default)/documents/${docPath}`,
      fields: toFirestoreFields(dataObj).fields
    }
  };
}

// 📌 ฟังก์ชันส่ง Batch Write เข้า Firestore (แบ่ง Chunk ไม่เกิน 400 รายการต่อครั้ง)
function commitBatchToFirestore(writes) {
  if (!writes || writes.length === 0) return;
  
  const keyFile = JSON.parse(PropertiesService.getScriptProperties().getProperty('FIREBASE_KEY'));
  const projectId = keyFile.project_id;
  const CHUNK_SIZE = 400; // Limit ของ Firestore อยู่ที่ 500 รายการต่อ Batch

  for (let i = 0; i < writes.length; i += CHUNK_SIZE) {
    const chunk = writes.slice(i, i + CHUNK_SIZE);
    const res = callFirestore("POST", ":commit", { writes: chunk });
    
    if (res && res.error) {
      console.error("❌ Batch Error: " + JSON.stringify(res.error));
    } else {
      Logger.log(`⚡ บันทึก Batch สำเร็จ (${chunk.length} รายการ)`);
    }
  }
}

