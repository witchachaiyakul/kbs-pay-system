// ----------------------------------------------------------------------------
// ฟังก์ชันช่วยแปลงโครงสร้างฟิลด์ของ Firestore ให้เป็น Object ทั่วไป
// ----------------------------------------------------------------------------
function parseFirestoreFields(fields) {
  const result = {};
  if (!fields) return result;

  for (const key in fields) {
    const val = fields[key];
    if ('stringValue' in val) result[key] = val.stringValue;
    else if ('doubleValue' in val) result[key] = val.doubleValue;
    else if ('integerValue' in val) result[key] = Number(val.integerValue);
    else if ('booleanValue' in val) result[key] = val.booleanValue;
    else if ('arrayValue' in val) {
      result[key] = (val.arrayValue.values || []).map(v => {
        if (v.mapValue && v.mapValue.fields) return parseFirestoreFields(v.mapValue.fields);
        return v.stringValue || v.doubleValue || v.integerValue || v.booleanValue;
      });
    } else if ('mapValue' in val && val.mapValue.fields) {
      result[key] = parseFirestoreFields(val.mapValue.fields);
    }
  }
  return result;
}

