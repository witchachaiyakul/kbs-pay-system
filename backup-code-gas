// 🎯 1. ฟังก์ชันประมวลผลหลัก (ห้ามเปลี่ยนชื่อตัวนี้)
// ============================================================================
function internalParseThaiDate(thaiDateStr) {
  if (!thaiDateStr) return '';
  const months = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];
  
  let cleanStr = thaiDateStr.replace(/เดือน|พ\.ศ\./g, '').replace(/\s+/g, ' ').trim();
  let parts = cleanStr.split(' ');
  
  if (parts.length >= 3) {
    let day = parts[0].padStart(2, '0');
    let monthName = parts[1];
    let year = parseInt(parts[2]) - 543; // แปลง พ.ศ. เป็น ค.ศ.
    let monthIdx = months.indexOf(monthName);
    
    if (monthIdx !== -1 && !isNaN(year)) {
      let month = String(monthIdx + 1).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }
  }
  return '';
}

function parseThaiDateToIso(str) { return internalParseThaiDate(str); }
function parseThaiDateToISO(str) { return internalParseThaiDate(str); }
function parsethaidatetoiso(str) { return internalParseThaiDate(str); }
function parseThaiDateTolso(str) { return internalParseThaiDate(str); }

