function isLineIdAllowed(lineUserId) {
  try {
    const userData = callFirestore("GET", "users/" + lineUserId);
    if (!userData || userData.error || !userData.fields) return null;
    
    const status = userData.fields.status ? userData.fields.status.stringValue : "";
    if (status === "active") {
      const role = (userData.fields.role && userData.fields.role.stringValue) || "staff";
      const allowedOptionsStr = (userData.fields.allowedOptions && userData.fields.allowedOptions.stringValue) || "";
      return {
        role: role,
        allowedOptions: allowedOptionsStr ? allowedOptionsStr.split(",").map(item => item.trim()) : []
      };
    }
    return null;
  } catch (e) {
    console.error("❌ ตรวจสอบสิทธิ์ผู้ใช้ล้มเหลว: " + e.toString());
    return null;
  }
}

function insertAuditLog(actionType, detailsTxt, lineUserObj) {
  try {
    const logData = {
      timestamp: new Date().toISOString(),
      action: actionType,       
      details: detailsTxt,      
      user_id: lineUserObj ? lineUserObj.id : "System",
      user_name: lineUserObj ? lineUserObj.name : "Unknown",
      user_picture: lineUserObj ? lineUserObj.picture : ""
    };

    const logDocId = `LOG_${Date.now()}_${Utilities.getUuid().substring(0,8)}`;
    callFirestore("PATCH", `audit_logs/${encodeURIComponent(logDocId)}`, toFirestoreFields(logData));
    console.log(`✅ Audit Log Saved: [${actionType}] ${detailsTxt}`);
  } catch (e) {
    console.error("❌ บันทึก Audit Log ล้มเหลว: " + e.toString());
  }
}

// ============================================================================
// 🔥 FIRESTORE REST ENGINE (NO LIBRARY DEPENDENCY)
// ============================================================================

function callFirestore(method, path, payload = null) {
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const token = getAccessToken(keyFile);
  const projectId = keyFile.project_id;
  
  let baseUrl = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents`;
  let finalUrl = baseUrl + (path ? (path.startsWith(':') || path.startsWith('?') ? path : '/' + path) : '');

  const options = {
    method: method,
    headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
    muteHttpExceptions: true
  };
  if (payload) options.payload = JSON.stringify(payload);

  const response = UrlFetchApp.fetch(finalUrl, options);
  const resText = response.getContentText();
  
  try {
    return JSON.parse(resText);
  } catch (e) {
    return { error: "HTML_RESPONSE_ERROR", details: resText.substring(0, 100) };
  }
}

function getAccessToken(key) {
  const cache = CacheService.getScriptCache();
  const cachedToken = cache.get("firebase_master_token"); 
  if (cachedToken) return cachedToken;

  const header = JSON.stringify({ alg: "RS256", typ: "JWT" });
  const now = Math.floor(Date.now() / 1000);
  const claimSet = JSON.stringify({
    iss: key.client_email,
    scope: "https://www.googleapis.com/auth/datastore https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/cloud-platform", 
    aud: "https://oauth2.googleapis.com/token",
    exp: now + 3600,
    iat: now
  });

  const encode = (str) => Utilities.base64EncodeWebSafe(str).replace(/=+$/, "");
  const signatureInput = encode(header) + "." + encode(claimSet);
  const privateKey = key.private_key.replace(/\\n/g, '\n');
  const signature = Utilities.computeRsaSha256Signature(signatureInput, privateKey);
  const jwt = signatureInput + "." + encode(signature);

  const response = UrlFetchApp.fetch("https://oauth2.googleapis.com/token", {
    method: "POST",
    payload: { grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer", assertion: jwt },
    muteHttpExceptions: true
  });
  
  const data = JSON.parse(response.getContentText());
  if (data.access_token) {
    cache.put("firebase_master_token", data.access_token, 3000);
    return data.access_token;
  }
  return null;
}

function toFirestoreFields(obj) {
  const fields = {};
  if (obj && typeof obj === 'object') {
    for (const key in obj) {
      if (Object.prototype.hasOwnProperty.call(obj, key) && obj[key] !== undefined) {
        fields[key] = toFirestoreValue(obj[key]);
      }
    }
  }
  return { fields: fields };
}

function toFirestoreValue(val) {
  // 🎯 1. ถ้าเป็น null หรือ undefined ให้ส่ง ENUM "NULL_VALUE" ของ Firestore (ไม่ใช่ null)
  if (val === null || val === undefined) {
    return { nullValue: "NULL_VALUE" };
  }
  
  if (Array.isArray(val)) {
    return { arrayValue: { values: val.map(toFirestoreValue) } };
  }
  
  if (typeof val === 'object' && !(val instanceof Date)) {
    const mapFields = {};
    for (const k in val) {
      if (Object.prototype.hasOwnProperty.call(val, k) && val[k] !== undefined) {
        mapFields[k] = toFirestoreValue(val[k]);
      }
    }
    return { mapValue: { fields: mapFields } };
  }
  
  if (typeof val === 'number') {
    return { doubleValue: val };
  }
  
  if (typeof val === 'boolean') {
    return { booleanValue: val };
  }
  
  return { stringValue: String(val) };
}

function getFirestore() {
  const privateKey = PropertiesService.getScriptProperties().getProperty('FIREBASE_KEY');
  return FirestoreApp.getFirestore(
    FIREBASE_CONFIG.email,
    privateKey,
    FIREBASE_CONFIG.projectId
  );
}

// ============================================================================
// 🔍 FIRESTORE BUDGET & PAY SEARCH (ค้นหา log_pay ก่อน -> แล้วค่อยค้น log_budget)
// ============================================================================
function getBudgetInfo(logNo) {
  try {
    if (!logNo) return { success: false, message: 'กรุณาระบุเลข นผ.2' };

    const cleanLogNo = String(logNo).trim();

    // ฟังก์ชันช่วยดึงข้อมูลจาก Firestore
    function fetchDocFromFirestore(collectionName, id) {
      if (!id) return null;

      let docPath = collectionName + "/" + encodeURIComponent(id);
      let res = callFirestore("GET", docPath);
      if (res && res.fields) {
        return parseFirestoreFields(res.fields);
      }

      const runQueryByField = (fieldName) => {
        const queryPayload = {
          structuredQuery: {
            from: [{ collectionId: collectionName }],
            where: {
              fieldFilter: {
                field: { fieldPath: fieldName },
                op: "EQUAL",
                value: { stringValue: id }
              }
            },
            limit: 1
          }
        };
        const queryRes = callFirestore("POST", ":runQuery", queryPayload);
        if (Array.isArray(queryRes) && queryRes.length > 0 && queryRes[0].document && queryRes[0].document.fields) {
          return parseFirestoreFields(queryRes[0].document.fields);
        }
        return null;
      };

      return runQueryByField("log_no") || runQueryByField("LOG_NO");
    }

    // 1. ค้นหาใน log_pay และ log_budget
    let payData = fetchDocFromFirestore("log_pay", cleanLogNo);
    let budgetData = fetchDocFromFirestore("log_budget", cleanLogNo);

    // 2. ดึงข้อมูล Master Plan จาก budget_plans
    let planData = null;
    const projectId = (budgetData && budgetData.project_id) || (payData && payData.project_id);
    if (projectId) {
      planData = fetchDocFromFirestore("budget_plans", projectId);
    }

    // 3. กรณีพบข้อมูลใน log_pay (เคยพิมพ์เบิกจ่ายแล้ว)
    if (payData) {
      const addr = payData.seller_address || {};
      const fin = payData.financial || {};
      
      const rawCommittee = payData.committee || [];
      const formattedCommittee = Array.isArray(rawCommittee) ? rawCommittee.map(c => ({
        name: c.name || c.comm_name || '',
        pos: c.pos || c.position || ''
      })) : [];

      const rawItems = payData.items || [];
      const formattedItems = rawItems.map(item => ({
        list: item.equipment || item.list || '',
        torlist: item.torlist || '',
        qu: item.qu !== undefined ? item.qu : 0,
        un: item.un || '',
        pr: item.pr !== undefined ? item.pr : 0,
        am: item.am !== undefined ? item.am : 0,
        pr_type: item.pr_type || 'ซื้อ'
      }));

      // 🎯 [ส่วนที่เพิ่มใหม่]: แกะเมทาดาตาของ PO เดิม (base_no, sub_no, year_be) กรณีใน log_pay มีเฉพาะ po_no
      const poNoStr = payData.po_no || '';
      let poBaseNo = Number(payData.po_base_no || payData.base_no) || 0;
      let poSubNo = Number(payData.po_sub_no || payData.sub_no) || 0;
      let poYearBe = Number(payData.po_year_be || payData.year_be) || 0;
      let docType = payData.doc_type || 'po';

      if ((poBaseNo === 0 || poYearBe === 0) && poNoStr.includes('/')) {
        const parts = poNoStr.split('/');
        poBaseNo = Number(parts[0]) || 0;
        if (parts.length === 3) {
          poSubNo = Number(parts[1]) || 1;
          poYearBe = Number(parts[2]) || (new Date().getFullYear() + 543);
        } else if (parts.length === 2) {
          poSubNo = 1;
          poYearBe = Number(parts[1]) || (new Date().getFullYear() + 543);
        }
      }

      return {
        success: true,
        isPaid: true,
        rowNumber: cleanLogNo,
        data: {
          logNo: payData.log_no || payData.LOG_NO || cleanLogNo,
          
          // ข้อมูลงานแผน
          division: payData.division || payData.ฝ่าย || (budgetData ? (budgetData.division || budgetData.ฝ่าย) : '') || (planData ? planData.division : '') || '',
          project: payData.project || payData.โครงการ || (budgetData ? (budgetData.project || budgetData.โครงการ) : '') || (planData ? planData.project_name : '') || '',
          activities: payData.activities || payData.กิจกรรม || (budgetData ? (budgetData.activities || budgetData.กิจกรรม) : '') || (planData ? planData.activity_name : '') || '',
          budget_use: fin.total || payData.budget_use || payData.amount || (budgetData ? budgetData.budget_use : '0.00'),
          method: payData.method || payData.วิธีการ || (budgetData ? budgetData.method : '') || '',
          details: payData.details || payData.รายละเอียด || (budgetData ? budgetData.details : '') || '',
          
          // ผู้ขอซื้อ ตำแหน่ง และ 3 วันที่
          buyer: payData.buyer || '',
          pos_buyer: payData.pos_buyer || '',
          memo_date: payData.memo_date || '',
          ctor_date: payData.ctor_date || '',
          tor_rp_date: payData.tor_rp_date || '',

          // ข้อมูลการเบิกจ่ายและร้านค้า
          to: payData.to || '',
          delivery_days: payData.d_dateline || payData.delivery_days || '7',
          seller_name: payData.seller || payData.seller_name || '',
          seller2: payData.seller2 || '',
          seller3: payData.seller3 || '',
          bidder_name: payData.sell_name || payData.bidder_name || '',
          
          // ข้อมูลที่อยู่ผู้ขาย
          tax_id: addr.taxid || payData.tax_id || payData.taxid || '',
          tel_no: addr.ad_ph || payData.tel_no || '',
          address_no: addr.ad_no || payData.address_no || '',
          address_moo: addr.ad_m || payData.address_moo || '',
          address_road: addr.ad_rd || payData.address_road || '',
          address_subdistrict: addr.ad_tb || payData.address_subdistrict || '',
          address_district: addr.ad_mu || payData.address_district || '',
          address_province: addr.ad_pr || payData.address_province || '',
          zip_code: addr.postid || payData.zip_code || '',
          
          // 🎯 ข้อมูล PO ครบชุด (ส่งกลับให้หน้าบ้านหยอดใส่ฟอร์ม)
          po_no: poNoStr,
          po_date: payData.po_date || '',
          doc_type: docType,
          po_base_no: poBaseNo,
          po_sub_no: poSubNo,
          po_year_be: poYearBe,

          // เอกสาร วันที่ และภาษี
          invoice_type: payData.invoice_type || '',
          doc_date: payData.invoice_date || payData.doc_date || payData.cr_date || '',
          doc_no: payData.invoice_no || payData.doc_no || '',
          book_no: payData.invoice_book || payData.book_no || '',
          qu_date: payData.qu_date || '',
          rc_date: payData.rc_date || '',
          announce_date: payData.announce_date || '',
          deadline: payData.deadline || '',
          
          // รายละเอียดการเงิน
          vat_type: fin.vat_type || payData.vat_type || 'no_vat',
          fin_total: fin.total || 0,
          fin_ex_vat: fin.ex_vat || 0,
          fin_vat: fin.vat || 0,
          fin_value: fin.value || 0,
          fin_income_tax: fin.income_tax || 0,
          fin_act_paid: fin.act_paid || 0,
          
          items: formattedItems,
          committee: formattedCommittee
        }
      };
    }

    // 4. กรณีพบเฉพาะใน log_budget (ยังไม่เคยพิมพ์เบิกจ่าย)
    if (budgetData) {
      return {
        success: true,
        isPaid: false,
        rowNumber: cleanLogNo,
        data: {
          logNo: budgetData.LOG_NO || budgetData.logNo || budgetData.log_no || cleanLogNo,
