    tempSheetFile = templateFile.makeCopy(`TEMP_${fileName}`);
    logBenchmark("2. คัดลอกไฟล์ Template (makeCopy)");

    const tempSs = SpreadsheetApp.openById(tempSheetFile.getId());
    logBenchmark("3. เปิดไฟล์ชั่วคราว (openById)");
    
    // 2. ดึง Sheet "form"
    const sheet = tempSs.getSheetByName("form");
    if (!sheet) {
      Logger.log("❌ ไม่พบ Sheet ชื่อ 'form' ใน Template");
      return null;
    }

    // ลบ Tab อื่นที่ไม่ใช้ออก
    const sheetsToDelete = tempSs.getSheets().filter(s => s.getName() !== "form");
    sheetsToDelete.forEach(s => tempSs.deleteSheet(s));
    logBenchmark(`4. ลบ Tab ที่ไม่ใช้ออก (${sheetsToDelete.length} Tabs)`);

    // 3. จัดรูปแบบวันที่ภาษาไทยอย่างปลอดภัย
    let formattedDate = "";
    if (logData.date) {
      const dateObj = new Date(logData.date);
      if (!isNaN(dateObj.getTime())) {
        const thaiMonths = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];
        formattedDate = `${dateObj.getDate()} ${thaiMonths[dateObj.getMonth()]} ${dateObj.getFullYear() + 543}`;
      }
    }

    const formatNumStr = (num) => String(Number(num || 0).toLocaleString('th-TH', {minimumFractionDigits: 2}));

    // รวม method + details สำหรับวางช่อง "เรื่อง"
    const methodStr = logData.method ? String(logData.method).trim() : "";
    const detailsStr = logData.details ? String(logData.details).trim() : "";
    const combinedDetails = methodStr && detailsStr ? `${methodStr}${detailsStr}` : (methodStr || detailsStr || "");

    // คำนวณกลุ่มบริหารงานและคำนำหน้าตำแหน่ง
    const divStr = planData.division ? String(planData.division).trim() : "";
    let divPrefix = "รองผู้อำนวยการกลุ่มบริหารงาน";
    if (divStr.includes("กิจการนักเรียน")) {
      divPrefix = "ครูปฏิบัติหน้าที่รองผู้อำนวยการกลุ่มบริหารงาน";
    }
    const divisionTitle = divStr ? `${divPrefix}${divStr}` : "";

    // เงื่อนไขกำหนดผู้พิจารณา/กรรมการตามกลุ่มงาน
    let committeePerson = "";
    if (divStr.includes("บริหารทั่วไป")) committeePerson = "ว่าที่ร้อยตรีศรายุทธ พงค์ทองเมือง";
    else if (divStr.includes("วิชาการ")) committeePerson = "นางคนึงนิตย์ แฉล้มรักษ์";
    else if (divStr.includes("บุคคล")) committeePerson = "นางสาวสุทธิดา ธนบัตร";
    else if (divStr.includes("งบประมาณ")) committeePerson = "นางสาวเปรมฤดี จูหลง";
    else if (divStr.includes("กิจการนักเรียน")) committeePerson = "นายจีรพจน์ ทองขาว";

    // 🎯 4. เงื่อนไขแยกประเภทเงิน (fund_type) หยอดลงแถว 1, 2, 3 หรือ 4
    const fundType = String(planData.fund_type || "").trim();
    let targetRow = 1;

    const row1Types = ["รายได้สถานศึกษา", "รายได้ SMTE", "รายได้ STI", "รายได้ คอมพิวเตอร์", "รายได้ ภาษาอังกฤษ", "รายได้ EIS", "รายได้ ภาษาจีน", "รายได้ หอพัก"];
    const row2Types = ["อุดหนุน", "อุดหนุน งบประมาณคงเหลือปี 68"];
    const row3Types = ["กิจกรรมพัฒนาผู้เรียน"];

    if (row1Types.some(t => fundType.includes(t)) || fundType.startsWith("รายได้")) {
      targetRow = 1;
    } else if (row2Types.some(t => fundType.includes(t))) {
      targetRow = 2;
    } else if (row3Types.some(t => fundType.includes(t))) {
      targetRow = 3;
    } else {
      targetRow = 4; // อื่นๆ / เงินสนับสนุน
    }

    Logger.log(`🏷️ ประเภทเงิน: "${fundType}" -> หยอดข้อมูลลงตารางแถวที่: ${targetRow}`);

    // 🎯 5. เตรียมชุดข้อมูลแทนค่า (กำหนดค่าเริ่มต้นของแถวที่ไม่เกี่ยวข้องเป็นค่าว่าง "")
    const replacements = {
      "{{log_no}}": String(logData.log_no || ""),
      "{{date}}": String(formattedDate),
      "{{details}}": String(detailsStr || ""),
      "{{method}}": String(methodStr || ""),
      "{{method_details}}": String(combinedDetails), 
      "{{full_details}}": String(combinedDetails),
      "{{division}}": String(divStr || ""),
      "{{division_prefix}}": String(divPrefix),
      "{{division_title}}": String(divisionTitle),
      "{{full_division}}": String(divisionTitle),
      "{{committees}}": String(committeePerson),
      "{{committee}}": String(committeePerson),
      "{{project_name}}": String(planData.project_name || ""),
      "{{activity_name}}": String(planData.activity_name || ""),
      "{{responsible_person}}": String(planData.responsible_person || ""),
      "{{requested_by}}": String(logData.requested_by || ""),
      "{{applicant}}": String(logData.requested_by || ""),
      
      // ค่าเดี่ยวแบบไม่ใส่เลขแถว (เผื่อใน Template ใช้)
      "{{total_budget}}": formatNumStr(planData.total_budget),
      "{{used_budget}}": formatNumStr(logData.balance_before),
      "{{budget_use}}": formatNumStr(logData.budget_use),
      "{{remaining_budget}}": formatNumStr(logData.balance_after)
    };

    // ลูปตั้งค่าตาราง 4 แถวเป็นค่าว่าง "" ก่อน
    for (let i = 1; i <= 4; i++) {
      replacements[`{{total_budget${i}}}`] = "";
      replacements[`{{used_budget${i}}}`] = "";
      replacements[`{{budget_use${i}}}`] = "";
      replacements[`{{remaining_budget${i}}}`] = "";
    }

    // หยอดข้อมูลเฉพาะแถวเป้าหมาย (targetRow)
    replacements[`{{total_budget${targetRow}}}`] = formatNumStr(planData.total_budget);
    replacements[`{{used_budget${targetRow}}}`] = formatNumStr(logData.balance_before);
    replacements[`{{budget_use${targetRow}}}`] = formatNumStr(logData.budget_use);
    replacements[`{{remaining_budget${targetRow}}}`] = formatNumStr(logData.balance_after);

    logBenchmark("5. เตรียมข้อมูลผูกตัวแปรครบถ้วน");

    // 6. วนลูปแทนค่าข้อความทั้งหมด (รวมถึงเปลี่ยนปีกกาแถวอื่นเป็นค่าว่าง "")
    let replacedCount = 0;
    Object.keys(replacements).forEach(key => {
      const count = sheet.createTextFinder(key)
                         .matchEntireCell(false)
                         .replaceAllWith(replacements[key]);
      replacedCount += count;
    });

    logBenchmark(`6. แทนค่าข้อความเรียบร้อย (${replacedCount} จุด)`);

    // บังคับซิงก์ข้อมูลลงแผ่นงาน
    SpreadsheetApp.flush();
    logBenchmark("7. สั่ง Flush บันทึกข้อมูลลง Sheet");

    // 7. สร้าง PDF
    const pdfBlob = fetchCustomPdfBlob(tempSs, sheet, `${fileName}.pdf`);
    logBenchmark("8. สร้าง PDF Blob ผ่าน UrlFetchApp");

    const pdfFile = targetFolder.createFile(pdfBlob);
    logBenchmark("9. เซฟไฟล์ PDF ลง Google Drive Folder");

    Logger.log(`🎉 สร้าง PDF สำเร็จ! ลิงก์ไฟล์: ${pdfFile.getUrl()}`);

    return {
      pdf_id: pdfFile.getId(),
      pdf_url: pdfFile.getUrl()
    };

  } catch (error) {
    Logger.log("❌ เกิดข้อผิดพลาดร้ายแรง: " + error.toString());
    return null;
  } finally {
    if (tempSheetFile) {
      try {
        tempSheetFile.setTrashed(true);
        logBenchmark("10. ลบไฟล์ Sheet ชั่วคราวทิ้ง");
      } catch (e) {}
    }
  }
}

// ============================================================================
// 🛠️ Helper Function: ส่งออก PDF เต็มหน้า A4 พอดี 1 หน้า
// ============================================================================
function fetchCustomPdfBlob(spreadsheet, sheet, pdfFileName) {
  const ssId = spreadsheet.getId();
  const sheetId = sheet.getSheetId();

  const url = `https://docs.google.com/spreadsheets/d/${ssId}/export?` +
    `exportFormat=pdf&format=pdf` +
    `&size=A4&portrait=true&fitw=true&scale=4` +
    `&gridlines=false&printtitle=false&sheetnames=false` +
    `&fpid=false&fcf=false&pagenumbers=false` +
    `&horizontal_alignment=CENTER&gid=${sheetId}` +
    `&top_margin=0.35&bottom_margin=0.35&left_margin=0.35&right_margin=0.35`;

  const token = ScriptApp.getOAuthToken();
  const response = UrlFetchApp.fetch(url, {
    headers: { 'Authorization': 'Bearer ' + token }
  });

  return response.getBlob().setName(pdfFileName);
}

